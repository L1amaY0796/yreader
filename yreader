# 主程式
# --------------------------------------------------------------------------
def dump(doc):
    out = []
    for i, p in enumerate(doc.paras):
        if i and (p.gap or p.newpage or p.style == 'h'):
            out.append('')
        out.append(p.text)
    try:
        sys.stdout.write('\n'.join(out) + '\n')
    except BrokenPipeError:
        pass


def main():
    ap = argparse.ArgumentParser(
        prog='yreader',
        description='輕量終端機電子書閱讀器 (epub / mobi / azw3 / fb2 / html / txt)',
        epilog='不帶檔名執行時會開啟上次閱讀的書。閱讀中按 ? 顯示按鍵說明。')
    ap.add_argument('file', nargs='?', help='電子書檔案')
    ap.add_argument('-c', '--color', choices=COLORS, help='文字顏色 (預設沿用上次的設定)')
    ap.add_argument('--dump', action='store_true', help='輸出純文字後離開')
    ap.add_argument('-V', '--version', action='version', version='yreader ' + VERSION)
    args = ap.parse_args()

    try:
        locale.setlocale(locale.LC_ALL, '')
    except locale.Error:
        pass
    state = load_state()
    books = state['books']
    path = args.file
    if not path:
        recent = sorted(books, key=lambda k: books[k].get('time', 0), reverse=True)
        path = next((p for p in recent if os.path.isfile(p)), None)
        if not path:
            ap.print_usage(sys.stderr)
            return 2
    if not os.path.isfile(path):
        sys.stderr.write('yreader: 找不到檔案: %s\n' % path)
        return 1
    try:
        doc = load(path)
    except Exception as e:
        sys.stderr.write('yreader: 無法讀取 %s: %s\n' % (path, e or type(e).__name__))
        return 1

    if args.dump or not sys.stdout.isatty():
        dump(doc)
        return 0

    os.environ.setdefault('ESCDELAY', '25')
    import curses
    key = os.path.realpath(path)
    saved = books.get(key, {})
    pos = (int(saved.get('para', 0)), int(saved.get('off', 0)))
    color = args.color or state.get('color') or 'white'

    def bye(*_):
        raise SystemExit(0)

    signal.signal(signal.SIGTERM, bye)
    signal.signal(signal.SIGHUP, bye)

    def run(scr):
        r = Reader(scr, curses, doc, pos, color)
        try:
            r.loop()
        except KeyboardInterrupt:
            pass
        finally:
            pi, off = r.position()
            books[key] = {'para': pi, 'off': off, 'title': doc.title, 'time': int(time.time())}
            state['color'] = COLORS[r.ci]
            save_state(state)

    curses.wrapper(run)
    return 0


if __name__ == '__main__':
    sys.exit(main())

# --------------------------------------------------------------------------
# 文字寬度與換行
# --------------------------------------------------------------------------
_wcache = {}


def cwidth(ch):
    o = ord(ch)
    if o < 0x300:
        return 1
    w = _wcache.get(ch)
    if w is None:
        if unicodedata.category(ch) in ('Mn', 'Me', 'Cf'):
            w = 0
        elif unicodedata.east_asian_width(ch) in 'WF':
            w = 2
        else:
            w = 1
        _wcache[ch] = w
    return w


def swidth(s):
    return sum(cwidth(c) for c in s)


def clip(s, w):
    """把字串截到顯示寬度 w 以內"""
    if w <= 0:
        return ''
    n = 0
    for i, c in enumerate(s):
        n += cwidth(c)
        if n > w:
            return s[:i]
    return s


def wrap(text, width):
    """回傳 [(start, end)]，每段的顯示寬度不超過 width"""
    out = []
    n = len(text)
    i = 0
    while i < n:
        w = 0
        j = i
        brk = -1
        while j < n:
            ch = text[j]
            cw = cwidth(ch)
            if w + cw > width:
                break
            w += cw
            j += 1
            if ch == ' ' or cw == 2:
                brk = j
            elif j < n and cwidth(text[j]) == 2:
                brk = j
        if j >= n:
            out.append((i, n))
            break
        if text[j] == ' ':
            e = j
        elif brk > i:
            e = brk
        else:
            e = j if j > i else i + 1
        if text[e] in NOSTART and e - 1 > i:      # 避頭點
            e -= 1
        out.append((i, e))
        i = e
        while i < n and text[i] == ' ':
            i += 1
    return out



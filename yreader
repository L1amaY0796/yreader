class Para(object):
    __slots__ = ('text', 'style', 'gap', 'newpage', 'links')

    def __init__(self, text, style, gap, newpage, links):
        self.text = text
        self.style = style        # p / h / pre / hr
        self.gap = gap            # 與前段之間是否空一行
        self.newpage = newpage    # 是否從新的一頁開始
        self.links = links        # [(start, end, href)]


class Doc(object):
    def __init__(self):
        self.title = ''
        self.paras = []
        self.anchors = {}         # key -> (段落索引, 字元位移)
        self.rawtoc = []          # [(層級, 標題, key)]
        self.toc = []             # [(層級, 標題, (段落, 位移))]
        self.cur = []
        self.curlen = 0
        self.endspace = False
        self.curlinks = []
        self.open = None          # (href, start)
        self.nextgap = 1
        self.newpage = False

    def add(self, s):
        if s:
            self.cur.append(s)
            self.curlen += len(s)
            self.endspace = s[-1] == ' '

    def pos(self):
        return (len(self.paras), self.curlen)

    def anchor(self, key):
        self.anchors.setdefault(key, self.pos())

    def open_link(self, href):
        self.close_link()
        self.open = (href, self.curlen)

    def close_link(self):
        if self.open:
            href, s = self.open
            if self.curlen > s:
                self.curlinks.append((s, self.curlen, href))
            self.open = None

    def flush(self, style='p', gap=1):
        href = self.open[0] if self.open else None
        self.close_link()
        text = ''.join(self.cur).rstrip()
        if text.strip():
            n = len(text)
            links = [(s, min(e, n), h) for s, e, h in self.curlinks if s < n]
            self.paras.append(Para(text, style, self.nextgap, self.newpage, links))
            self.newpage = False
            self.nextgap = gap
        else:
            self.nextgap = 1
        self.cur = []
        self.curlen = 0
        self.endspace = False
        self.curlinks = []
        if href is not None:
            self.open = (href, 0)

    def start_file(self, name):
        self.flush()
        self.open = None
        self.newpage = True
        self.anchor(name)

    def lookup(self, key):
        t = self.anchors.get(key)
        if t is None and '#' in key:
            base = key.split('#')[0]
            if base:
                t = self.anchors.get(base)
        if t is None or not self.paras:
            return None
        if t[0] >= len(self.paras):
            return (len(self.paras) - 1, 0)
        return t

    def finish(self):
        self.flush()
        if not self.paras:
            self.paras.append(Para('（沒有可顯示的內容）', 'p', 1, False, []))
        toc = []
        for lvl, title, key in self.rawtoc:
            t = self.lookup(key)
            if t and title:
                toc.append((lvl, title, t))
        if not toc:
            toc = [(0, p.text, (i, 0)) for i, p in enumerate(self.paras) if p.style == 'h']
        self.toc = toc


def resolve(base, href):
    """把相對連結轉成錨點 key（檔案路徑#id）"""
    href = href.strip()
    if SCHEME.match(href):
        return href
    path, _, frag = href.partition('#')
    if path:
        path = posixpath.normpath(posixpath.join(posixpath.dirname(base), unquote(path)))
    else:
        path = base
    return path + '#' + unquote(frag) if frag else path


# --------------------------------------------------------------------------
# HTML -> 段落
# --------------------------------------------------------------------------
BLOCK = set('''p div h1 h2 h3 h4 h5 h6 li ul ol dl dt dd blockquote section article aside
header footer nav figure figcaption table tr caption pre body html center address
title subtitle empty-line v stanza epigraph text-author cite poem annotation'''.split())
HEAD_HTML = {'h1', 'h2', 'h3', 'h4', 'h5', 'h6'}
HEAD_FB2 = HEAD_HTML | {'title', 'subtitle'}
SKIP_HTML = {'script', 'style', 'title', 'svg', 'rp', 'math'}
SKIP_FB2 = {'script', 'style', 'binary', 'description'}


class ContentParser(HTMLParser):
    def __init__(self, doc, base='', fb2=False):
        HTMLParser.__init__(self, convert_charrefs=True)
        self.doc = doc
        self.base = base
        self.heads = HEAD_FB2 if fb2 else HEAD_HTML
        self.skips = SKIP_FB2 if fb2 else SKIP_HTML
        self.skip = 0
        self.h = False
        self.pre = False

    def run(self, text):
        try:
            self.feed(text)
            self.close()
        except Exception:
            pass
        self.doc.flush(self.style())

    def style(self):
        return 'pre' if self.pre else 'h' if self.h else 'p'

    def handle_starttag(self, tag, attrs):
        d = self.doc
        if self.skip:
            if tag in self.skips:
                self.skip += 1
            return
        if tag in self.skips:
            if tag == 'svg':
                d.add(IMAGE)
            self.skip = 1
            return
        a = dict(attrs)
        if tag in BLOCK:
            d.flush(self.style())
        i = a.get('id') or (a.get('name') if tag == 'a' else None)
        if i:
            d.anchor(self.base + '#' + i)
        if tag == 'br':
            d.flush(self.style(), 0)
        elif tag == 'hr':
            d.flush(self.style())
            d.add('* * *')
            d.flush('hr')
        elif tag in ('img', 'image'):
            d.add(IMAGE)
        elif tag in self.heads:
            self.h = True
        elif tag == 'pre':
            self.pre = True
        elif tag == 'li':
            if d.paras and d.paras[-1].text.startswith('• '):
                d.nextgap = 0
            d.add('• ')
        elif tag in ('td', 'th'):
            if d.curlen:
                d.add(' │ ')
        elif tag == 'a':
            href = None
            for k, v in attrs:
                if v and (k == 'href' or k.endswith(':href')):
                    href = v
            if href:
                d.open_link(resolve(self.base, href))
        elif tag == 'mbp:pagebreak':
            d.flush(self.style())
            d.newpage = True
        elif tag == 'rt':
            d.add('(')

    def handle_endtag(self, tag):
        d = self.doc
        if self.skip:
            if tag in self.skips:
                self.skip -= 1
            return
        if tag == 'a':
            d.close_link()
        elif tag == 'rt':
            d.add(')')
        elif tag in BLOCK:
            d.flush(self.style())
            if tag in self.heads:
                self.h = False
            elif tag == 'pre':
                self.pre = False

    def handle_data(self, data):
        if self.skip:
            return
        d = self.doc
        if self.pre:
            for i, ln in enumerate(data.split('\n')):
                if i:
                    d.flush('pre', 0)
                d.add(CTRL.sub('', ln.expandtabs(4)))
            return
        s = CTRL.sub('', WS.sub(' ', data)).replace('\xa0', ' ')
        if d.curlen == 0 or d.endspace:
            s = s.lstrip(' ')
        d.add(s)


def decode(raw, extra=()):
    if raw[:3] == b'\xef\xbb\xbf':
        return raw[3:].decode('utf-8', 'replace')
    if raw[:2] in (b'\xff\xfe', b'\xfe\xff'):
        return raw.decode('utf-16', 'replace')
    encs = []
    m = re.search(br'''(?:encoding|charset)\s*=\s*["']?([\w\-]+)''', raw[:1024])
    if m:
        encs.append(m.group(1).decode('ascii', 'replace'))
    encs.append('utf-8')
    encs.extend(extra)
    for enc in encs:
        try:
            return raw.decode(enc)
        except (LookupError, UnicodeDecodeError):
            pass
    return raw.decode('utf-8', 'replace')



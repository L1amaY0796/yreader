def guess_lang():
    if os.name == 'nt':
        try:
            import ctypes
            return 'zh' if ctypes.windll.kernel32.GetUserDefaultUILanguage() & 0x3ff == 0x04 else 'en'
        except Exception:
            return 'en'
    for v in ('LC_ALL', 'LC_MESSAGES', 'LANG'):
        val = os.environ.get(v)
        if val:
            return 'zh' if val.lower().startswith('zh') else 'en'
    return 'en'


# --------------------------------------------------------------------------
# 文字寬度與換行
# --------------------------------------------------------------------------
_wcache = {}


def cwidth(ch):
    o = ord(ch)
    if o < 0x300:
        return 1
    w = _wcache.get(ch)
    if w is None:
        if unicodedata.category(ch) in ('Mn', 'Me', 'Cf') or \
                0x1160 <= o <= 0x11ff or 0xd7b0 <= o <= 0xd7ff:   # 組合符號、韓文字母的中聲/終聲
            w = 0
        elif unicodedata.east_asian_width(ch) in 'WF':
            w = 2
        else:
            w = 1
        _wcache[ch] = w
    return w


def swidth(s):
    return sum(cwidth(c) for c in s)


def clip(s, w):
    """把字串截到顯示寬度 w 以內"""
    if w <= 0:
        return ''
    n = 0
    for i, c in enumerate(s):
        n += cwidth(c)
        if n > w:
            return s[:i]
    return s


def wrap(text, width, indent=0):
    """回傳 [(start, end)]，每段的顯示寬度不超過 width（第一行少 indent 欄）"""
    out = []
    n = len(text)
    i = 0
    lim = max(1, width - indent)
    while i < n:
        w = 0
        j = i
        brk = pb = -1
        while j < n:
            ch = text[j]
            cw = cwidth(ch)
            if w + cw > lim:
                break
            w += cw
            j += 1
            if cw == 0:
                if ch == '\u200d':       # ZWJ：前後都不可斷行（表情符號組合）
                    brk = pb
                elif brk == j - 1:       # 組合符號要跟著前一個字
                    brk = j
            elif ch == ' ' or cw == 2 or (j < n and cwidth(text[j]) == 2):
                pb = brk
                brk = j
        if j >= n:
            out.append((i, n))
            break
        if text[j] == ' ':
            e = j
        elif brk > i:
            e = brk
        else:
            e = j if j > i else i + 1
        if text[e] in NOSTART and e - 1 > i:      # 避頭點
            e -= 1
            while e - 1 > i and cwidth(text[e]) == 0:
                e -= 1
        if text[e - 1] in NOEND and e - 1 > i:    # 避尾點
            e -= 1
        out.append((i, e))
        i = e
        lim = width
        while i < n and text[i] == ' ':
            i += 1
    return out



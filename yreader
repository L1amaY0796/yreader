BLANK = (-1, 0, 0)


def layout(paras, W, H):
    """回傳 (lines, first)；lines 為 [(段落, 起, 迄)]，first[段落] = 第一行的索引"""
    lines = []
    first = [0] * len(paras)
    prev = None
    for pi, p in enumerate(paras):
        if lines:
            if p.newpage:
                r = len(lines) % H
                if r:
                    lines.extend([BLANK] * (H - r))
            elif (p.gap or p.style == 'h' or prev.style == 'h') and len(lines) % H:
                lines.append(BLANK)
        first[pi] = len(lines)
        for s, e in wrap(p.text, W):
            lines.append((pi, s, e))
        prev = p
    return lines, first



# 用外部程式開啟圖片
# --------------------------------------------------------------------------
_tmp = {'dir': None, 'files': {}}


def image_ext(data):
    head = data[:16]
    if head[:3] == b'\xff\xd8\xff':
        return '.jpg'
    if head[:8] == b'\x89PNG\r\n\x1a\n':
        return '.png'
    if head[:4] == b'GIF8':
        return '.gif'
    if head[:4] == b'RIFF' and head[8:12] == b'WEBP':
        return '.webp'
    if head[:2] == b'BM':
        return '.bmp'
    if b'<svg' in data[:2048]:
        return '.svg'
    return '.img'


def save_image(key, data):
    """把圖片寫到暫存資料夾（離開時自動刪除），回傳路徑"""
    if key in _tmp['files']:
        return _tmp['files'][key]
    if _tmp['dir'] is None:
        _tmp['dir'] = tempfile.mkdtemp(prefix='yreader-')
        atexit.register(shutil.rmtree, _tmp['dir'], True)
    path = os.path.join(_tmp['dir'], 'image-%03d%s' % (len(_tmp['files']) + 1, image_ext(data)))
    with open(path, 'wb') as f:
        f.write(data)
    _tmp['files'][key] = path
    return path


def spawn(argv):
    kw = {'stdin': subprocess.DEVNULL, 'stdout': subprocess.DEVNULL, 'stderr': subprocess.DEVNULL}
    if os.name != 'nt':
        kw['start_new_session'] = True        # 不要讓看圖程式跟著閱讀器一起被關掉
    subprocess.Popen(argv, **kw)
    return True


def open_external(path):
    """用系統預設的看圖程式開啟；可用環境變數 YREADER_IMAGE_VIEWER 指定程式"""
    try:
        custom = os.environ.get('YREADER_IMAGE_VIEWER')
        if custom:
            import shlex
            return spawn(shlex.split(custom, posix=os.name != 'nt') + [path])
        if os.name == 'nt':
            os.startfile(path)
            return True
        if sys.platform == 'darwin':
            return spawn(['open', path])
        if os.environ.get('WSL_DISTRO_NAME') or 'microsoft' in os.uname().release.lower():
            if shutil.which('wslview'):       # WSL：交給 Windows 那邊的看圖程式
                return spawn(['wslview', path])
            if shutil.which('wslpath') and shutil.which('explorer.exe'):
                win = subprocess.check_output(['wslpath', '-w', path]).decode('utf-8', 'replace').strip()
                return spawn(['explorer.exe', win])
        if os.environ.get('DISPLAY') or os.environ.get('WAYLAND_DISPLAY'):
            for cmd in ('xdg-open', 'gio', 'eog', 'feh', 'display'):
                if shutil.which(cmd):
                    return spawn([cmd, 'open', path] if cmd == 'gio' else [cmd, path])
    except Exception:
        pass
    return False



def load_text(raw, doc):
    for line in decode(raw).splitlines():
        line = norm(CTRL.sub('', line.expandtabs(4))).rstrip()
        if line.strip():
            doc.add(line)
            doc.flush('p', 0)
        else:
            doc.flush()


def load(path):
    doc = Doc()
    with open(path, 'rb') as f:
        head = f.read(2048)
    ext = os.path.splitext(path)[1].lower()
    if head[:2] == b'PK':
        load_epub(path, doc)
    elif head[60:68] in (b'BOOKMOBI', b'TEXtREAd'):
        load_mobi(path, doc)
    else:
        with open(path, 'rb') as f:
            raw = f.read()
        if b'<FictionBook' in head or ext == '.fb2':
            ContentParser(doc, '', fb2=True).run(decode(raw))
        elif ext in ('.html', '.htm', '.xhtml') or re.search(br'<html|<!doctype html', head, re.I):
            ContentParser(doc, '').run(decode(raw))
        else:
            load_text(raw, doc)
    doc.finish()
    if not doc.title:
        doc.title = os.path.splitext(os.path.basename(path))[0]
    return doc



BLANK = (-1, 0, 0)


def layout(paras, W, H):
    """回傳 (lines, first)；lines 為 [(段落, 起, 迄)]，first[段落] = 第一行的索引"""
    lines = []
    first = [0] * len(paras)
    prev = None
    for pi, p in enumerate(paras):
        if lines:
            if p.newpage:
                r = len(lines) % H
                if r:
                    lines.extend([BLANK] * (H - r))
            elif (p.gap or p.style == 'h' or prev.style == 'h') and len(lines) % H:
                lines.append(BLANK)
        segs = wrap(p.text, W)
        if p.style == 'h':            # 標題不要孤零零留在頁尾
            r = len(lines) % H
            if r and len(segs) + 2 <= H and H - r < len(segs) + 2:
                lines.extend([BLANK] * (H - r))
        first[pi] = len(lines)
        for s, e in segs:
            lines.append((pi, s, e))
        prev = p
    return lines, first



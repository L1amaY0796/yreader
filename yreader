        else:
            doc.flush()


def load(path):
    doc = Doc()
    with open(path, 'rb') as f:
        head = f.read(2048)
    ext = os.path.splitext(path)[1].lower()
    if head[:2] == b'PK':
        load_epub(path, doc)
    elif head[60:68] in (b'BOOKMOBI', b'TEXtREAd'):
        load_mobi(path, doc)
    else:
        with open(path, 'rb') as f:
            raw = f.read()
        if b'<FictionBook' in head or ext == '.fb2':
            def fb2_image(key):       # <binary id="..."> 裡的 base64
                m = re.search(br'<binary[^>]*\bid\s*=\s*["\']' + re.escape(key.lstrip('#').encode('utf-8'))
                              + br'["\'][^>]*>([^<]*)<', raw)
                return base64.b64decode(m.group(1)) if m else None

            doc.image_loader = fb2_image
            # 新版 Python 會把 <title> 的內容當純文字，先改名才能正確解析 FB2 的標題
            text = re.sub(r'<(/?)title\b', r'<\1subtitle', decode(raw))
            ContentParser(doc, '', fb2=True).run(text)
        elif ext in ('.html', '.htm', '.xhtml') or re.search(br'<html|<!doctype html', head, re.I):
            folder = os.path.dirname(os.path.abspath(path))

            def html_image(key):      # 相對於 HTML 檔所在資料夾
                with open(os.path.join(folder, key.split('#')[0]), 'rb') as f:
                    return f.read()

            doc.image_loader = html_image
            ContentParser(doc, '').run(decode(raw))
        else:
            load_text(raw, doc)
    doc.finish()
    if not doc.title:
        doc.title = os.path.splitext(os.path.basename(path))[0]
    return doc



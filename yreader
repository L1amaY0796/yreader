# EPUB
# --------------------------------------------------------------------------
def local(tag):
    return tag.rsplit('}', 1)[-1] if isinstance(tag, str) else ''


class NavParser(HTMLParser):
    """EPUB3 nav 文件 -> 目錄"""

    def __init__(self, base):
        HTMLParser.__init__(self, convert_charrefs=True)
        self.base = base
        self.out = []
        self.on = 0
        self.lvl = 0
        self.href = None
        self.text = []

    def handle_starttag(self, tag, attrs):
        a = dict(attrs)
        if tag == 'nav':
            if self.on:
                self.on += 1
            elif 'toc' in (a.get('epub:type') or 'toc'):
                self.on = 1
                self.lvl = 0
        elif not self.on:
            return
        elif tag == 'ol':
            self.lvl += 1
        elif tag == 'a' and a.get('href'):
            self.href = a['href']
            self.text = []

    def handle_endtag(self, tag):
        if not self.on:
            return
        if tag == 'nav':
            self.on -= 1
        elif tag == 'ol':
            self.lvl -= 1
        elif tag == 'a' and self.href:
            title = ' '.join(''.join(self.text).split())
            self.out.append((max(0, self.lvl - 1), title, resolve(self.base, self.href)))
            self.href = None

    def handle_data(self, data):
        if self.href:
            self.text.append(data)


def ncx_toc(xml, base):
    out = []

    def walk(e, lvl):
        for c in e:
            t = local(c.tag)
            if t == 'navPoint':
                label, src = '', None
                for g in c:
                    gt = local(g.tag)
                    if gt == 'navLabel':
                        label = ' '.join(''.join(g.itertext()).split())
                    elif gt == 'content':
                        src = g.get('src')
                if src:
                    out.append((lvl, label, resolve(base, src)))
                walk(c, lvl + 1)
            elif t == 'navMap':
                walk(c, lvl)

    walk(ET.fromstring(xml), 0)
    return out


def load_epub(path, doc):
    z = zipfile.ZipFile(path)
    names = set(z.namelist())
    lower = dict((n.lower(), n) for n in names)

    def read(name):
        if name not in names:
            name = lower[name.lower()]
        return z.read(name)

    opf = None
    for e in ET.fromstring(read('META-INF/container.xml')).iter():
        if local(e.tag) == 'rootfile':
            opf = unquote(e.get('full-path') or '')
            break
    if not opf:
        raise ValueError('找不到 OPF')
    opfdir = posixpath.dirname(opf)
    manifest, spine, tocid = {}, [], None
    for e in ET.fromstring(read(opf)).iter():
        t = local(e.tag)
        if t == 'item':
            href = posixpath.normpath(posixpath.join(opfdir, unquote(e.get('href') or '')))
            manifest[e.get('id')] = (href, e.get('media-type') or '', e.get('properties') or '')
        elif t == 'itemref':
            spine.append(e.get('idref'))
        elif t == 'spine':
            tocid = e.get('toc')
        elif t == 'title' and not doc.title:
            doc.title = ' '.join((e.text or '').split())

    for idref in spine:
        if idref not in manifest:
            continue
        href, mt, _ = manifest[idref]
        try:
            raw = read(href)
        except KeyError:
            continue
        doc.start_file(href)
        if mt.startswith('image/'):
            doc.add(IMAGE)
            continue
        ContentParser(doc, href).run(decode(raw))

    # 目錄：先找 NCX，再找 EPUB3 nav
    cands = [manifest[tocid]] if tocid in manifest else []
    cands += [v for v in manifest.values() if v[1] == 'application/x-dtbncx+xml']
    for href, _, _ in cands:
        try:
            doc.rawtoc = ncx_toc(read(href), href)
        except Exception:
            continue
        if doc.rawtoc:
            return
    for href, _, props in manifest.values():
        if 'nav' in props.split():
            try:
                p = NavParser(href)
                p.feed(decode(read(href)))
                doc.rawtoc = p.out
            except Exception:
                pass
            return


# --------------------------------------------------------------------------
# MOBI / AZW / AZW3 (KF8)
# --------------------------------------------------------------------------
NONE = 0xffffffff


class MobiError(Exception):
    pass


def palmdoc(data):
    out = bytearray()
    i, n = 0, len(data)
    while i < n:
        c = data[i]
        i += 1
        if c == 0 or 9 <= c < 0x80:
            out.append(c)
        elif c <= 8:
            out += data[i:i + c]
            i += c
        elif c >= 0xc0:
            out.append(32)
            out.append(c ^ 0x80)
        elif i < n:
            c = (c << 8) | data[i]
            i += 1
            dist = (c >> 3) & 0x7ff
            if dist == 0 or dist > len(out):
                continue
            for _ in range((c & 7) + 3):
                out.append(out[-dist])
    return bytes(out)


class Huff(object):
    """HUFF/CDIC 解壓"""

    def __init__(self, huff, cdics):
        if huff[:8] != b'HUFF\x00\x00\x00\x18':
            raise MobiError('HUFF 標頭錯誤')
        off1, off2 = struct.unpack_from('>LL', huff, 8)
        self.dict1 = []
        for v in struct.unpack_from('<256L', huff, off1):
            codelen, term, maxcode = v & 0x1f, v & 0x80, v >> 8
            self.dict1.append((codelen, term, ((maxcode + 1) << (32 - codelen)) - 1))
        d2 = struct.unpack_from('<64L', huff, off2)
        self.mincode = [0] + [m << (32 - (i + 1)) for i, m in enumerate(d2[0::2])]
        self.maxcode = [0] + [((m + 1) << (32 - (i + 1))) - 1 for i, m in enumerate(d2[1::2])]
        self.dictionary = []
        for cdic in cdics:
            if cdic[:8] != b'CDIC\x00\x00\x00\x10':
                raise MobiError('CDIC 標頭錯誤')
            phrases, bits = struct.unpack_from('>LL', cdic, 8)
            n = min(1 << bits, phrases - len(self.dictionary))
            for off in struct.unpack_from('>%dH' % n, cdic, 16):
                blen, = struct.unpack_from('>H', cdic, 16 + off)
                self.dictionary.append((cdic[18 + off:18 + off + (blen & 0x7fff)], blen & 0x8000))

    def unpack(self, data):
        bitsleft = len(data) * 8
        data += b'\x00' * 8
        pos = 0
        x, = struct.unpack_from('>Q', data, pos)
        n = 32
        out = []
        while True:
            if n <= 0:
                pos += 4
                x, = struct.unpack_from('>Q', data, pos)
                n += 32
            code = (x >> n) & 0xffffffff
            codelen, term, maxcode = self.dict1[code >> 24]
            if not term:
                while code < self.mincode[codelen]:
                    codelen += 1
                maxcode = self.maxcode[codelen]
            n -= codelen
            bitsleft -= codelen
            if bitsleft < 0:
                break
            r = (maxcode - code) >> (32 - codelen)
            sl, flag = self.dictionary[r]
            if not flag:
                self.dictionary[r] = (b'', 1)
                sl = self.unpack(sl)
                self.dictionary[r] = (sl, 1)
            out.append(sl)
        return b''.join(out)


def varint(data, pos):
    val = n = 0
    while True:
        b = data[pos + n]
        n += 1
        val = (val << 7) | (b & 0x7f)
        if b & 0x80:
            return n, val


def tagmap(cbc, tags, data, start, end):
    found = []
    cbi = 0
    ds = start + cbc
    for tag, per, mask, endflag in tags:
        if endflag == 1:
            cbi += 1
            continue
        value = data[start + cbi] & mask
        if value:
            if value == mask:
                if bin(mask).count('1') > 1:
                    c, value = varint(data, ds)
                    ds += c
                    found.append((tag, None, value, per))
                else:
                    found.append((tag, 1, None, per))
            else:
                while mask & 1 == 0:
                    mask >>= 1
                    value >>= 1
                found.append((tag, value, None, per))
    out = {}
    for tag, count, nbytes, per in found:
        vals = []
        if count is not None:
            for _ in range(count * per):
                c, v = varint(data, ds)
                ds += c
                vals.append(v)
        else:
            used = 0
            while used < nbytes:
                c, v = varint(data, ds)
                ds += c
                used += c
                vals.append(v)
        out[tag] = vals
    return out


def inject(raw, marks):
    """在指定的位元組位置插入標記（避開標籤內部）"""
    adj = {}
    for pos in sorted(marks):
        p = min(max(pos, 0), len(raw))
        lo = max(0, p - 4096)
        if raw.rfind(b'<', lo, p) > raw.rfind(b'>', lo, p):
            p = raw.rfind(b'<', lo, p)
        adj[p] = adj.get(p, b'') + marks[pos]
    out = []
    last = 0
    for p in sorted(adj):
        out.append(raw[last:p])
        out.append(adj[p])
        last = p
    out.append(raw[last:])
    return b''.join(out)


class Mobi(object):
    def __init__(self, data):
        self.data = data
        self.n, = struct.unpack_from('>H', data, 76)
        self.offs = [struct.unpack_from('>L', data, 78 + 8 * i)[0] for i in range(self.n)]
        self.offs.append(len(data))

    def rec(self, i):
        return self.data[self.offs[i]:self.offs[i + 1]]

    def index(self, idx):
        data = self.rec(idx)
        if data[:4] != b'INDX':
            raise MobiError('INDX 錯誤')
        hlen, = struct.unpack_from('>L', data, 4)
        count, = struct.unpack_from('>L', data, 24)
        nctoc, = struct.unpack_from('>L', data, 52)
        ctoc = [self.rec(idx + count + 1 + j) for j in range(nctoc)]
        cbc, tags = 0, []
        if data[hlen:hlen + 4] == b'TAGX':
            first, cbc = struct.unpack_from('>LL', data, hlen + 4)
            for i in range(12, first, 4):
                tags.append(tuple(data[hlen + i:hlen + i + 4]))
        out = []
        for i in range(idx + 1, idx + 1 + count):
            d = self.rec(i)
            start, n = struct.unpack_from('>LL', d, 20)
            pos = [struct.unpack_from('>H', d, start + 4 + 2 * j)[0] for j in range(n)]
            pos.append(start)
            for j in range(n):
                s, e = pos[j], pos[j + 1]
                tl = d[s]
                out.append((d[s + 1:s + 1 + tl], tagmap(cbc, tags, d, s + 1 + tl, e)))
        return out, ctoc

    def extract(self):
        """回傳 (標題, html 文字, 目錄)"""
        h = self.rec(0)
        comp, _, _, nrec, _, enc = struct.unpack_from('>HHLHHH', h, 0)
        if enc:
            raise MobiError('此檔案有 DRM 保護，無法讀取')

        def u32(off):
            return struct.unpack_from('>L', h, off)[0] if off + 4 <= len(h) else NONE

        ismobi = h[16:20] == b'MOBI'
        codec, ver, extra, title = 'cp1252', 1, 0, ''
        if ismobi:
            hlen = u32(20)
            ver = u32(36)
            if u32(28) == 65001:
                codec = 'utf-8'
            if hlen >= 0xe4 and len(h) >= 0xf4:
                extra, = struct.unpack_from('>H', h, 0xf2)
            toff, tlen = u32(0x54), u32(0x58)
            if toff != NONE and toff + tlen <= len(h):
                title = h[toff:toff + tlen].decode(codec, 'replace')

        if comp == 1:
            dec = bytes
        elif comp == 2:
            dec = palmdoc
        elif comp == 17480 and ismobi:
            hoff, hnum = u32(0x70), u32(0x74)
            dec = Huff(self.rec(hoff), [self.rec(hoff + i) for i in range(1, hnum)]).unpack
        else:
            raise MobiError('不支援的壓縮格式 %d' % comp)

        trailers = bin(extra >> 1).count('1')
        parts = []
        for i in range(1, min(nrec, self.n - 1) + 1):
            r = self.rec(i)
            for _ in range(trailers):
                num = 0
                for v in r[-4:]:
                    if v & 0x80:
                        num = 0
                    num = (num << 7) | (v & 0x7f)
                r = r[:max(0, len(r) - num)]
            if extra & 1 and r:
                r = r[:max(0, len(r) - ((r[-1] & 3) + 1))]
            parts.append(dec(r))
        raw = b''.join(parts)

        marks = {}
        fragpos = None
        if ver == 8:
            try:
                raw, fragpos, breaks = self.kf8(raw, u32(0xfc), u32(0xf8))
                for p in breaks:
                    marks[p] = b'<mbp:pagebreak/>'
            except Exception:
                fragpos = None
                try:
                    f = self.rec(u32(0xc0))
                    if f[:4] == b'FDST':
                        s, e = struct.unpack_from('>LL', f, 12)
                        raw = raw[s:e]
                except Exception:
                    pass

        def mark(pos):
            marks[pos] = marks.get(pos, b'') + b'<a id="fp%d"></a>' % pos

        # 目錄 (NCX 索引)
        toc = []
        ncx = u32(0xf4) if ismobi else NONE
        if ncx != NONE:
            try:
                entries, ctoc = self.index(ncx)
                for _, tm in entries:
                    off = tm[3][0]
                    c = ctoc[off >> 16]
                    k, ln = varint(c, off & 0xffff)
                    label = c[(off & 0xffff) + k:(off & 0xffff) + k + ln].decode(codec, 'replace')
                    if ver == 8:
                        if fragpos is None or 6 not in tm:
                            continue
                        pos = fragpos[tm[6][0]] + tm[6][1]
                    else:
                        pos = tm[1][0]
                    toc.append((pos, tm.get(4, [0])[0], ' '.join(label.split())))
                toc.sort(key=lambda t: t[0])
            except Exception:
                toc = []
        for pos, _, _ in toc:
            mark(pos)

        # 連結
        if ver == 8:
            link = re.compile(br'kindle:pos:fid:([0-9A-V]{4}):off:([0-9A-V]{10})')

            def target(m):
                fid = int(m.group(1), 32)
                if fragpos is None or fid >= len(fragpos):
                    return None
                return fragpos[fid] + int(m.group(2), 32)

            def sub(m):
                t = target(m)
                return m.group(0) if t is None else b'#fp%d' % t
        else:
            link = re.compile(br'''filepos\s*=\s*["']?0*(\d+)["']?''')

            def target(m):
                return int(m.group(1))

            def sub(m):
                return b'href="#fp%d"' % int(m.group(1))

        seen = set(marks)
        for m in link.finditer(raw):
            t = target(m)
            if t is not None and t not in seen:
                seen.add(t)
                mark(t)
        for pos, _, _ in toc:
            seen.add(pos)
        raw = link.sub(sub, inject(raw, marks))
        return title, raw.decode(codec, 'replace'), [(lvl, label, '#fp%d' % pos) for pos, lvl, label in toc]

    def kf8(self, raw, skelidx, fragidx):
        """把 KF8 的骨架與片段組回完整 HTML"""
        skel, _ = self.index(skelidx)
        frag, _ = self.index(fragidx)
        out = bytearray()
        fragpos, breaks = [], []
        fi = 0
        for _, tm in skel:
            cnt = tm[1][0]
            spos, slen = tm[6][0], tm[6][1]
            base = spos + slen
            s = bytearray(raw[spos:base])
            for _ in range(cnt):
                ftext, ftm = frag[fi]
                fi += 1
                ins = int(ftext)
                flen = ftm[6][1]
                fragpos.append(ins)
                s[ins - spos:ins - spos] = raw[base:base + flen]
                base += flen
            if len(out) < spos:
                out += b' ' * (spos - len(out))
            breaks.append(len(out))
            out += s
        return bytes(out), fragpos, breaks


def load_mobi(path, doc):
    with open(path, 'rb') as f:
        data = f.read()
    doc.title, text, doc.rawtoc = Mobi(data).extract()
    ContentParser(doc, '').run(text)



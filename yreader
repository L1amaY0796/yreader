# 文件模型
# --------------------------------------------------------------------------
class Para(object):
    __slots__ = ('text', 'style', 'gap', 'newpage', 'links')

    def __init__(self, text, style, gap, newpage, links):
        self.text = text
        self.style = style        # p / h / pre / hr
        self.gap = gap            # 與前段之間是否空一行
        self.newpage = newpage    # 是否從新的一頁開始
        self.links = links        # [(start, end, href)]


class Doc(object):
    def __init__(self):
        self.title = ''
        self.paras = []
        self.anchors = {}         # key -> (段落索引, 字元位移)
        self.rawtoc = []          # [(層級, 標題, key)]
        self.toc = []             # [(層級, 標題, (段落, 位移))]
        self.cur = []
        self.curlen = 0
        self.endspace = False
        self.curlinks = []
        self.open = None          # (href, start)
        self.nextgap = 1
        self.newpage = False
        self.blobs = []           # 內嵌在 HTML 裡的 data: 圖片
        self.image_loader = None  # 依格式而定：key -> 圖片的位元組

    def add_image(self, key):
        """加入 <image> 佔位文字；找得到圖片來源時讓它可以被選取"""
        s = self.curlen
        self.add(IMAGE)
        if key and not self.open:         # 圖片本身包在連結裡時，以連結為準
            self.curlinks.append((s, self.curlen, IMG + key))

    def get_image(self, key):
        if key.startswith('blob:'):
            head, _, data = self.blobs[int(key[5:])].partition(',')
            return base64.b64decode(data) if ';base64' in head.lower() else unquote_to_bytes(data)
        return self.image_loader(key)

    def add(self, s):
        if s:
            self.cur.append(s)
            self.curlen += len(s)
            self.endspace = s[-1] == ' '

    def pos(self):
        return (len(self.paras), self.curlen)

    def anchor(self, key):
        self.anchors.setdefault(key, self.pos())

    def open_link(self, href):
        self.close_link()
        self.open = (href, self.curlen)

    def close_link(self):
        if self.open:
            href, s = self.open
            if self.curlen > s:
                self.curlinks.append((s, self.curlen, href))
            self.open = None

    def flush(self, style='p', gap=1):
        href = self.open[0] if self.open else None
        self.close_link()
        text = ''.join(self.cur).rstrip()
        if text.strip():
            n = len(text)
            links = [(s, min(e, n), h) for s, e, h in self.curlinks if s < n]
            self.paras.append(Para(text, style, self.nextgap, self.newpage, links))
            self.newpage = False
            self.nextgap = gap
        else:
            self.nextgap = 1
        self.cur = []
        self.curlen = 0
        self.endspace = False
        self.curlinks = []
        if href is not None:
            self.open = (href, 0)

    def start_file(self, name):
        self.flush()
        self.open = None
        self.newpage = True
        self.anchor(name)

    def lookup(self, key):
        t = self.anchors.get(key)
        if t is None and '#' in key:
            base = key.split('#')[0]
            if base:
                t = self.anchors.get(base)
        if t is None or not self.paras:
            return None
        if t[0] >= len(self.paras):
            return (len(self.paras) - 1, 0)
        return t

    def finish(self):
        self.flush()
        if not self.paras:
            self.paras.append(Para(T('empty'), 'p', 1, False, []))
        toc = []
        for lvl, title, key in self.rawtoc:
            t = self.lookup(key)
            if t and title:
                toc.append((lvl, title, t))
        if not toc:
            toc = [(0, p.text, (i, 0)) for i, p in enumerate(self.paras) if p.style == 'h']
        self.toc = toc


def resolve(base, href):
    """把相對連結轉成錨點 key（檔案路徑#id）"""
    href = href.strip()
    if SCHEME.match(href):
        return href
    path, _, frag = href.partition('#')
    if path:
        path = posixpath.normpath(posixpath.join(posixpath.dirname(base), unquote(path)))
    else:
        path = base
    return path + '#' + unquote(frag) if frag else path



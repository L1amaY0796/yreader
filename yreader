BLOCK = set('''p div h1 h2 h3 h4 h5 h6 li ul ol dl dt dd blockquote section article aside
header footer nav figure figcaption table tr caption pre body html center address
title subtitle empty-line v stanza epigraph text-author cite poem annotation'''.split())
HEAD_HTML = {'h1', 'h2', 'h3', 'h4', 'h5', 'h6'}
HEAD_FB2 = HEAD_HTML | {'title', 'subtitle'}
SKIP_HTML = {'script', 'style', 'title', 'svg', 'rp', 'math'}
SKIP_FB2 = {'script', 'style', 'binary', 'description'}


class ContentParser(HTMLParser):
    def __init__(self, doc, base='', fb2=False):
        HTMLParser.__init__(self, convert_charrefs=True)
        self.doc = doc
        self.base = base
        self.heads = HEAD_FB2 if fb2 else HEAD_HTML
        self.skips = SKIP_FB2 if fb2 else SKIP_HTML
        self.skip = 0
        self.h = False
        self.pre = False

    def run(self, text):
        try:
            self.feed(text)
            self.close()
        except Exception:
            pass
        self.doc.flush(self.style())

    def style(self):
        return 'pre' if self.pre else 'h' if self.h else 'p'

    def handle_starttag(self, tag, attrs):
        d = self.doc
        if self.skip:
            if tag in self.skips:
                self.skip += 1
            return
        if tag in self.skips:
            if tag == 'svg':
                d.add(IMAGE)
            self.skip = 1
            return
        a = dict(attrs)
        if tag in BLOCK:
            d.flush(self.style())
        i = a.get('id') or (a.get('name') if tag == 'a' else None)
        if i:
            d.anchor(self.base + '#' + i)
        if tag == 'br':
            d.flush(self.style(), 0)
        elif tag == 'hr':
            d.flush(self.style())
            d.add('* * *')
            d.flush('hr')
        elif tag in ('img', 'image'):
            d.add(IMAGE)
        elif tag in self.heads:
            self.h = True
        elif tag == 'pre':
            self.pre = True
        elif tag == 'li':
            if d.paras and d.paras[-1].text.startswith('• '):
                d.nextgap = 0
            d.add('• ')
        elif tag in ('td', 'th'):
            if d.curlen:
                d.add(' │ ')
        elif tag == 'a':
            href = None
            for k, v in attrs:
                if v and (k == 'href' or k.endswith(':href')):
                    href = v
            if href:
                d.open_link(resolve(self.base, href))
        elif tag == 'mbp:pagebreak':
            d.flush(self.style())
            d.newpage = True
        elif tag == 'rt':
            d.add('(')

    def handle_endtag(self, tag):
        d = self.doc
        if self.skip:
            if tag in self.skips:
                self.skip -= 1
            return
        if tag == 'a':
            d.close_link()
        elif tag == 'rt':
            d.add(')')
        elif tag in BLOCK:
            d.flush(self.style())
            if tag in self.heads:
                self.h = False
            elif tag == 'pre':
                self.pre = False

    def handle_data(self, data):
        if self.skip:
            return
        d = self.doc
        if self.pre:
            for i, ln in enumerate(data.split('\n')):
                if i:
                    d.flush('pre', 0)
                d.add(norm(CTRL.sub('', ln.expandtabs(4))))
            return
        s = norm(CTRL.sub('', WS.sub(' ', data)).replace('\xa0', ' '))
        if d.curlen == 0 or d.endspace:
            s = s.lstrip(' ')
        d.add(s)


def norm(s):
    """把拆開的組合字（NFD 的越南文、韓文、日文濁音等）合併，避免寬度算錯與顯示錯亂"""
    return unicodedata.normalize('NFC', s) if DECOMPOSED.search(s) else s



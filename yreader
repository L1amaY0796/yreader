# HTML -> 段落
# --------------------------------------------------------------------------
BLOCK = set('''p div h1 h2 h3 h4 h5 h6 li ul ol dl dt dd blockquote section article aside
header footer nav figure figcaption table tr caption pre body html center address
title subtitle empty-line v stanza epigraph text-author cite poem annotation'''.split())
HEAD_HTML = {'h1', 'h2', 'h3', 'h4', 'h5', 'h6'}
HEAD_FB2 = HEAD_HTML | {'title', 'subtitle'}
SKIP_HTML = {'script', 'style', 'title', 'svg', 'rp', 'math'}
SKIP_FB2 = {'script', 'style', 'binary', 'description'}


class ContentParser(HTMLParser):
    def __init__(self, doc, base='', fb2=False):
        HTMLParser.__init__(self, convert_charrefs=True)
        self.doc = doc
        self.base = base
        self.heads = HEAD_FB2 if fb2 else HEAD_HTML
        self.skips = SKIP_FB2 if fb2 else SKIP_HTML
        self.skip = 0
        self.h = False
        self.pre = False
        self.in_svg = False
        self.svg_src = None

    def run(self, text):
        try:
            self.feed(text)
            self.close()
        except Exception:
            pass
        if self.in_svg:                   # 沒有關閉的 <svg>
            self.in_svg = False
            self.doc.add_image(self.svg_src)
        self.doc.flush(self.style())

    def image_key(self, attrs):
        """從 <img> / <image> 的屬性找出圖片來源"""
        a = dict(attrs)
        rec = (a.get('recindex') or '').strip()          # mobi
        if rec.isdigit():
            return 'rec:%d' % int(rec)
        src = a.get('src')
        if not src:
            for k, v in attrs:
                if v and (k == 'href' or k.endswith(':href')):
                    src = v
        if not src:
            return None
        src = src.strip()
        m = EMBED.match(src)                             # azw3
        if m:
            return 'rec:%d' % int(m.group(1), 32)
        if src[:5].lower() == 'data:':
            self.doc.blobs.append(src)
            return 'blob:%d' % (len(self.doc.blobs) - 1)
        if SCHEME.match(src):
            return None                                  # 網路上的圖片不處理
        return resolve(self.base, src)

    def style(self):
        return 'pre' if self.pre else 'h' if self.h else 'p'

    def handle_starttag(self, tag, attrs):
        d = self.doc
        if self.skip:
            if tag in self.skips:
                self.skip += 1
            elif tag == 'image' and self.in_svg and self.svg_src is None:
                self.svg_src = self.image_key(attrs)
            return
        if tag in self.skips:
            if tag == 'svg':              # 整個 <svg> 當成一張圖，結束時再加入
                self.in_svg = True
                self.svg_src = None
            self.skip = 1
            return
        a = dict(attrs)
        if tag in BLOCK:
            d.flush(self.style())
        i = a.get('id') or (a.get('name') if tag == 'a' else None)
        if i:
            d.anchor(self.base + '#' + i)
        if tag == 'br':
            d.flush(self.style(), 0)
        elif tag == 'hr':
            d.flush(self.style())
            d.add('* * *')
            d.flush('hr')
        elif tag in ('img', 'image'):
            d.add_image(self.image_key(attrs))
        elif tag in self.heads:
            self.h = True
        elif tag == 'pre':
            self.pre = True
        elif tag == 'li':
            if d.paras and d.paras[-1].text.startswith('• '):
                d.nextgap = 0
            d.add('• ')
        elif tag in ('td', 'th'):
            if d.curlen:
                d.add(' │ ')
        elif tag == 'a':
            href = None
            for k, v in attrs:
                if v and (k == 'href' or k.endswith(':href')):
                    href = v
            if href:
                d.open_link(resolve(self.base, href))
        elif tag == 'mbp:pagebreak':
            d.flush(self.style())
            d.newpage = True
        elif tag == 'rt':
            d.add('(')

    def handle_endtag(self, tag):
        d = self.doc
        if self.skip:
            if tag in self.skips:
                self.skip -= 1
                if not self.skip and self.in_svg:
                    self.in_svg = False
                    d.add_image(self.svg_src)
            return
        if tag == 'a':
            d.close_link()
        elif tag == 'rt':
            d.add(')')
        elif tag in BLOCK:
            d.flush(self.style())
            if tag in self.heads:
                self.h = False
            elif tag == 'pre':
                self.pre = False

    def handle_data(self, data):
        if self.skip:
            return
        d = self.doc
        if self.pre:
            for i, ln in enumerate(data.split('\n')):
                if i:
                    d.flush('pre', 0)
                d.add(norm(CTRL.sub('', ln.expandtabs(4))))
            return
        s = norm(CTRL.sub('', WS.sub(' ', data)).replace('\xa0', ' '))
        if d.curlen == 0 or d.endspace:
            s = s.lstrip(' ')
        d.add(s)


def norm(s):
    """把拆開的組合字（NFD 的越南文、韓文、日文濁音等）合併，避免寬度算錯與顯示錯亂"""
    return unicodedata.normalize('NFC', s) if DECOMPOSED.search(s) else s


FORCE_ENC = None         # --encoding 指定的編碼
ALIAS = {'gb2312': 'gb18030', 'gbk': 'gb18030', 'gb_2312-80': 'gb18030', 'x-gbk': 'gb18030',
         'big5': 'big5hkscs', 'big5-hkscs': 'big5hkscs', 'x-x-big5': 'big5hkscs',
         'shift_jis': 'cp932', 'shift-jis': 'cp932', 'sjis': 'cp932', 'x-sjis': 'cp932',
         'euc-kr': 'cp949', 'euc_kr': 'cp949', 'ks_c_5601-1987': 'cp949',
         'iso-8859-1': 'cp1252', 'latin1': 'cp1252', 'iso8859-1': 'cp1252'}
CJK_COMMON = set('的一是不了人我在有他這这为為之大来來以个個中上们們到说說国國和地也子时時道出而要于於'
                 '就下得可你年生自会會那后後能对對着著事其里裡所去行过過家十用发發天如然作方成者多日都三'
                 '小二无無同么麼经經法当當起与與好看学學进進种種将將还還分此心前面又定见見只主没沒公从從'
                 '，。、「」『』！？：；…—“”')


def cjk_score(text, kind):
    """猜的編碼對不對：解出來的非 ASCII 字元裡，該語言常見字元所佔的比例"""
    n = kana = hangul = common = 0
    for c in text:
        o = ord(c)
        if o < 0x80:
            continue
        n += 1
        if 0x3040 <= o <= 0x30ff:
            kana += 1
        elif 0xac00 <= o <= 0xd7a3:
            hangul += 1
        elif c in CJK_COMMON:
            common += 1
        if n >= 20000:
            break
    if not n:
        return 0.0
    n = float(n)
    if kind == 'ko':          # 真正的韓文幾乎全是諺文
        return hangul / n if hangul / n >= 0.85 else 0.0
    if kind == 'ja':          # 日文一定有相當比例的假名
        return (kana + common) / n if kana / n >= 0.15 else 0.0
    if kind == 'zh':
        return common / n
    return max(hangul / n if hangul / n >= 0.85 else 0.0, (kana + common) / n)


def guess_decode(raw):
    """沒有標示編碼、也不是 UTF-8 時，猜測中日韓常見編碼（含沒有 BOM 的 UTF-16）"""
    best, bs = None, 0.0
    for enc, kind in (('big5hkscs', 'zh'), ('gb18030', 'zh'), ('cp932', 'ja'), ('euc_jp', 'ja'),
                      ('cp949', 'ko'), ('utf-16-le', ''), ('utf-16-be', '')):
        try:
            t = raw.decode(enc)
        except UnicodeDecodeError:
            continue
        sc = cjk_score(t, kind)
        if sc > bs:
            best, bs = t, sc
    if best is not None and bs >= 0.15:
        return best
    try:
        enc = codecs.lookup(locale.getpreferredencoding(False)).name
    except LookupError:
        enc = 'utf-8'
    if enc in ('utf-8', 'ascii'):
        enc = 'cp1252'
    try:
        return raw.decode(enc)
    except UnicodeDecodeError:
        return raw.decode('cp1252', 'replace')


def decode(raw):
    if FORCE_ENC:
        return raw.decode(FORCE_ENC, 'replace')
    if raw[:3] == b'\xef\xbb\xbf':
        return raw[3:].decode('utf-8', 'replace')
    if raw[:2] in (b'\xff\xfe', b'\xfe\xff'):
        return raw.decode('utf-16', 'replace')
    if b'\0' in raw[:4096]:                    # 沒有 BOM 的 UTF-16：兩種位元組順序取較合理者
        best, bs = None, 0.15
        for enc in ('utf-16-le', 'utf-16-be'):
            try:
                t = raw.decode(enc)
            except UnicodeDecodeError:
                continue
            head = t[:20000]
            sc = sum(1 for c in head if ' ' <= c < '\x7f' or c == '\n') / float(len(head) or 1) \
                + cjk_score(head, '')
            if sc > bs:
                best, bs = t, sc
        if best is not None:
            return best
    encs = ['utf-8']
    m = re.search(br"""(?:encoding|charset)\s*=\s*["']?([\w\-]+)""", raw[:1024])
    if m:
        name = m.group(1).decode('ascii', 'replace').lower()
        encs.append(ALIAS.get(name, name))
    for enc in encs:
        try:
            return raw.decode(enc)
        except (LookupError, UnicodeDecodeError):
            pass
    return guess_decode(raw)



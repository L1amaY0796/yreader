class Reader(object):
    def __init__(self, scr, curses, doc, pos, color):
        self.scr = scr
        self.c = curses
        self.doc = doc
        self.ci = COLORS.index(color) if color in COLORS else 0
        self.page = 0
        self.sel = None           # 選取中的連結 (段落, 連結索引)
        self.mark = None          # 連結跳轉後標示的行
        self.hist = []
        self.msg = ''
        self.numbuf = None
        self.lines = []
        self.has_color = False
        try:
            curses.curs_set(0)
        except curses.error:
            pass
        try:
            if curses.has_colors():
                curses.start_color()
                try:
                    curses.use_default_colors()
                    bg = -1
                except curses.error:
                    bg = curses.COLOR_BLACK
                for i, col in enumerate((curses.COLOR_WHITE, curses.COLOR_GREEN, curses.COLOR_BLUE)):
                    curses.init_pair(i + 1, col, bg)
                self.has_color = True
        except curses.error:
            pass
        self.relayout(pos)

    # ---- 位置 ----
    def attr(self):
        return self.c.color_pair(self.ci + 1) if self.has_color else 0

    def relayout(self, pos=None):
        if pos is None:
            pos = self.position()
        rows, cols = self.scr.getmaxyx()
        self.H = max(1, rows - 2)
        self.W = max(8, min(cols - 4, MAX_WIDTH))
        self.x0 = max(0, (cols - self.W) // 2)
        self.lines, self.first = layout(self.doc.paras, self.W, self.H)
        self.npages = max(1, (len(self.lines) + self.H - 1) // self.H)
        self.toc_lines = [self.line_of(t) for _, _, t in self.doc.toc]
        self.page = min(self.line_of(pos) // self.H, self.npages - 1)
        self.mark = None

    def line_of(self, pos):
        pi, off = pos
        if not self.lines:
            return 0
        pi = min(max(pi, 0), len(self.first) - 1)
        i = self.first[pi]
        n = len(self.lines)
        while i + 1 < n and self.lines[i + 1][0] == pi and self.lines[i + 1][1] <= off:
            i += 1
        return i

    def position(self):
        base = self.page * self.H
        for i in range(base, min(base + self.H, len(self.lines))):
            pi, s, _ = self.lines[i]
            if pi >= 0:
                return (pi, s)
        return (0, 0)

    def set_page(self, n, remember=False):
        n = min(max(n, 0), self.npages - 1)
        if n != self.page:
            if remember:
                self.hist.append(self.position())
            self.page = n
        self.sel = None
        self.mark = None

    def jump(self, pos, mark=False):
        self.hist.append(self.position())
        ln = self.line_of(pos)
        self.page = min(ln // self.H, self.npages - 1)
        self.sel = None
        self.mark = ln if mark else None

    def cur_toc(self):
        end = (self.page + 1) * self.H
        cur = -1
        for i, ln in enumerate(self.toc_lines):
            if ln < end:
                cur = i
        return cur

    # ---- 繪製 ----
    def put(self, y, x, s, attr=0):
        rows, cols = self.scr.getmaxyx()
        if y < 0 or y >= rows or x < 0 or x >= cols:
            return x
        s = clip(s, cols - x)
        try:
            self.scr.addstr(y, x, s, attr)
        except self.c.error:
            pass
        except UnicodeError:      # 終端機編碼無法表示的字元
            enc = getattr(self.scr, 'encoding', None) or 'ascii'
            try:
                self.scr.addstr(y, x, s.encode(enc, 'replace').decode(enc, 'replace'), attr)
            except (self.c.error, UnicodeError, LookupError):
                pass
        return x + swidth(s)

    def status(self, left, right=''):
        rows, cols = self.scr.getmaxyx()
        a = self.attr() | self.c.A_REVERSE
        y = rows - 1
        self.put(y, 0, ' ' * (cols - 1), a)
        right = clip(right, cols - 2)
        room = cols - 3 - swidth(right)
        self.put(y, 1, clip(left, room), a)
        self.put(y, cols - 1 - swidth(right), right, a)

    def draw(self):
        c = self.c
        self.scr.erase()
        attr = self.attr()
        paras = self.doc.paras
        base = self.page * self.H
        for y in range(self.H):
            i = base + y
            if i >= len(self.lines):
                break
            pi, s, e = self.lines[i]
            if pi < 0:
                continue
            p = paras[pi]
            a = attr | (c.A_BOLD if p.style == 'h' else 0)
            x = self.x0
            if p.style in ('h', 'hr'):
                x += max(0, (self.W - swidth(p.text[s:e].rstrip())) // 2)
            if i == self.mark and self.x0 >= 2:
                self.put(y, self.x0 - 2, '>', attr | c.A_BOLD)
            pos = s
            for k, (ls, le, _) in enumerate(p.links):
                if le <= pos or ls >= e:
                    continue
                st, en = max(ls, pos), min(le, e)
                if st > pos:
                    x = self.put(y, x, p.text[pos:st], a)
                la = a | (c.A_REVERSE if self.sel == (pi, k) else c.A_UNDERLINE)
                x = self.put(y, x, p.text[st:en], la)
                pos = en
            if pos < e:
                self.put(y, x, p.text[pos:e], a)

        if self.numbuf is not None:
            self.status(T('goto', self.numbuf), T('total', self.npages))
        else:
            left = self.msg
            if not left:
                left = self.doc.title
                ti = self.cur_toc()
                if ti >= 0 and self.doc.toc[ti][1] != self.doc.title:
                    left += ' ─ ' + self.doc.toc[ti][1]
            pct = 100 * (self.page + 1) // self.npages
            self.status(left, T('status', self.page + 1, self.npages, pct))
        self.msg = ''
        self.scr.refresh()

    # ---- 輸入 ----
    def getkey(self):
        try:
            return self.scr.get_wch()
        except AttributeError:
            k = self.scr.getch()
            return chr(k) if 0 <= k < 256 else k
        except self.c.error:
            return None

    def is_enter(self, k):
        return k in ('\n', '\r', self.c.KEY_ENTER)

    def is_back(self, k):
        return k in (self.c.KEY_BACKSPACE, '\x7f', '\x08')

    # ---- 連結 ----
    def page_links(self):
        out = []
        base = self.page * self.H
        for i in range(base, min(base + self.H, len(self.lines))):
            pi, s, e = self.lines[i]
            if pi < 0:
                continue
            for k, (ls, le, _) in enumerate(self.doc.paras[pi].links):
                if ls < e and le > s and (pi, k) not in out:
                    out.append((pi, k))
        return out

    def cycle_link(self, step):
        links = self.page_links()
        if not links:
            self.msg = T('no_links')
            return
        if self.sel in links:
            self.sel = links[(links.index(self.sel) + step) % len(links)]
        else:
            self.sel = links[0 if step > 0 else -1]

    def follow(self):
        if self.sel is None:
            self.cycle_link(1)
            return
        pi, k = self.sel
        href = self.doc.paras[pi].links[k][2]
        if SCHEME.match(href):
            self.msg = T('ext_link', href)
            return
        t = self.doc.lookup(href)
        if t is None:
            self.msg = T('no_target', href)
            return
        self.jump(t, mark=True)

    def back(self):
        if not self.hist:
            self.msg = T('no_back')
            return
        pos = self.hist.pop()
        self.page = min(self.line_of(pos) // self.H, self.npages - 1)
        self.sel = None
        self.mark = None

    def chapter(self, step):
        pages = sorted(set(ln // self.H for ln in self.toc_lines))
        if step > 0:
            nxt = [p for p in pages if p > self.page]
        else:
            nxt = [p for p in reversed(pages) if p < self.page]
        if nxt:
            self.set_page(nxt[0], remember=True)
        else:
            self.msg = T('no_next' if step > 0 else 'no_prev')

    # ---- 目錄 / 說明 ----
    def toc_view(self):
        c = self.c
        toc = self.doc.toc
        if not toc:
            self.msg = T('no_toc')
            return
        cur = max(self.cur_toc(), 0)
        while True:
            rows, cols = self.scr.getmaxyx()
            h = max(1, rows - 2)
            w = max(8, min(cols - 4, MAX_WIDTH))
            x0 = max(0, (cols - w) // 2)
            top = min(max(0, cur - h // 2), max(0, len(toc) - h))
            attr = self.attr()
            self.scr.erase()
            self.put(0, x0, T('toc'), attr | c.A_BOLD)
            for y in range(h):
                i = top + y
                if i >= len(toc):
                    break
                lvl, title, _ = toc[i]
                pg = str(self.toc_lines[i] // self.H + 1)
                row = clip('  ' * min(lvl, 8) + title, w - len(pg) - 2)
                row += ' ' * (w - len(pg) - swidth(row)) + pg
                self.put(1 + y, x0, row, attr | (c.A_REVERSE if i == cur else 0))
            self.status(T('toc_hint'), '%d/%d' % (cur + 1, len(toc)))
            self.scr.refresh()
            k = self.getkey()
            if k == c.KEY_RESIZE:
                self.relayout()
            elif k in (c.KEY_DOWN, 'j'):
                cur = min(cur + 1, len(toc) - 1)
            elif k in (c.KEY_UP, 'k'):
                cur = max(cur - 1, 0)
            elif k in (c.KEY_NPAGE, ' '):
                cur = min(cur + h, len(toc) - 1)
            elif k == c.KEY_PPAGE:
                cur = max(cur - h, 0)
            elif k in (c.KEY_HOME, 'g'):
                cur = 0
            elif k in (c.KEY_END, 'G'):
                cur = len(toc) - 1
            elif self.is_enter(k) or k in (c.KEY_RIGHT, 'l'):
                self.jump(toc[cur][2])
                return
            elif k in ('t', 'q', '\x1b', c.KEY_LEFT, 'h'):
                return

    def help_view(self):
        c = self.c
        while True:
            rows, cols = self.scr.getmaxyx()
            attr = self.attr()
            self.scr.erase()
            self.put(0, 2, T('help_title', VERSION), attr | c.A_BOLD)
            table = HELP[LANG]
            col = 4 + max(swidth(keys) for keys, _ in table)
            for i, (keys, desc) in enumerate(table):
                self.put(2 + i, 2, keys, attr | c.A_BOLD)
                self.put(2 + i, col, desc, attr)
            self.status(T('anykey'))
            self.scr.refresh()
            k = self.getkey()
            if k == c.KEY_RESIZE:
                self.relayout()
            elif k is not None:
                return

    # ---- 主迴圈 ----
    def loop(self):
        global LANG, CHOSEN
        c = self.c
        nxt = {' ', 'j', 'l', 'n', 'f', c.KEY_DOWN, c.KEY_RIGHT, c.KEY_NPAGE}
        prv = {'k', 'h', 'p', c.KEY_UP, c.KEY_LEFT, c.KEY_PPAGE}
        while True:
            self.draw()
            k = self.getkey()
            if k is None:
                continue
            if k == c.KEY_RESIZE:
                self.relayout()
                continue
            if self.numbuf is not None:
                if isinstance(k, str) and k.isascii() and k.isdigit():
                    if len(self.numbuf) < 9:
                        self.numbuf += k
                elif self.is_back(k):
                    self.numbuf = self.numbuf[:-1] or None
                else:
                    if self.is_enter(k):
                        n = int(self.numbuf)
                        if 1 <= n <= self.npages:
                            self.set_page(n - 1, remember=True)
                        else:
                            self.msg = T('range', self.npages)
                    self.numbuf = None
                continue
            if isinstance(k, str) and k.isascii() and k.isdigit():
                self.numbuf = k
            elif k in nxt:
                if self.page >= self.npages - 1:
                    self.msg = T('last')
                self.set_page(self.page + 1)
            elif k in prv:
                if self.page == 0:
                    self.msg = T('first')
                self.set_page(self.page - 1)
            elif k in ('g', c.KEY_HOME):
                self.set_page(0, remember=True)
            elif k in ('G', c.KEY_END):
                self.set_page(self.npages - 1, remember=True)
            elif k == ']':
                self.chapter(1)
            elif k == '[':
                self.chapter(-1)
            elif k == '\t':
                self.cycle_link(1)
            elif k == c.KEY_BTAB:
                self.cycle_link(-1)
            elif self.is_enter(k):
                self.follow()
            elif self.is_back(k) or k == 'b':
                self.back()
            elif k == 't':
                self.toc_view()
            elif k == 'c':
                self.ci = (self.ci + 1) % len(COLORS)
                self.msg = T('color', T(COLORS[self.ci]))
            elif k == 'L':
                LANG = CHOSEN = LANGS[(LANGS.index(LANG) + 1) % len(LANGS)]
                self.msg = T('lang_now')
            elif k == '?':
                self.help_view()
            elif k == '\x1b':
                self.sel = None
            elif k in ('q', 'Q'):
                return


# --------------------------------------------------------------------------
# 主程式
# --------------------------------------------------------------------------
def dump(doc):
    out = []
    for i, p in enumerate(doc.paras):
        if i and (p.gap or p.newpage or p.style == 'h'):
            out.append('')
        out.append(p.text)
    try:
        sys.stdout.write('\n'.join(out) + '\n')
    except BrokenPipeError:
        pass


def can_show(text):
    try:
        text.encode(sys.stdout.encoding or 'ascii')
        return True
    except (UnicodeError, LookupError):
        return False


def ask_lang(default):
    """第一次執行時詢問介面語言"""
    zh = '繁體中文' if can_show('繁體中文') else 'Chinese'
    sys.stdout.write('Select interface language:\n  1) %s\n  2) English\n[1/2] (default %d): '
                     % (zh, LANGS.index(default) + 1))
    sys.stdout.flush()
    try:
        ans = sys.stdin.readline().strip().lower()
    except (OSError, UnicodeError, KeyboardInterrupt):
        ans = ''
    if ans in ('1', 'zh'):
        return 'zh'
    if ans in ('2', 'en'):
        return 'en'
    return default


def main():
    global LANG, FORCE_ENC
    try:
        locale.setlocale(locale.LC_ALL, '')
    except locale.Error:
        pass
    for stream in (sys.stdout, sys.stderr):
        try:
            stream.reconfigure(errors='replace')
        except (AttributeError, ValueError):
            pass
    state = load_state()
    books = state['books']
    saved_lang = state.get('lang') if state.get('lang') in LANGS else None
    zh_ok = can_show(STR['zh']['desc'])      # 終端機無法顯示中文時暫時用英文（不改設定）
    LANG = saved_lang or guess_lang()
    if not zh_ok:
        LANG = 'en'

    ap = argparse.ArgumentParser(prog='yreader', description=T('desc'), epilog=T('epilog'))
    ap.add_argument('file', nargs='?', help=T('arg_file'))
    ap.add_argument('-c', '--color', choices=COLORS, help=T('arg_color'))
    ap.add_argument('-l', '--lang', choices=LANGS, help=T('arg_lang'))
    ap.add_argument('-e', '--encoding', metavar='ENC', help=T('arg_enc'))
    ap.add_argument('--dump', action='store_true', help=T('arg_dump'))
    ap.add_argument('-V', '--version', action='version', version='yreader ' + VERSION)
    args = ap.parse_args()

    if args.lang:
        LANG = state['lang'] = args.lang
        save_state(state)
        if not zh_ok:
            LANG = 'en'
        if not args.file:
            print(STR[args.lang]['lang_set'] if zh_ok else 'Interface language saved: ' + args.lang)
            return 0
    elif not saved_lang and not args.dump and sys.stdin.isatty() and sys.stdout.isatty():
        LANG = state['lang'] = ask_lang(LANG)
        save_state(state)
        if not zh_ok:
            LANG = 'en'

    path = args.file
    if not path:
        recent = sorted(books, key=lambda k: books[k].get('time', 0), reverse=True)
        path = next((p for p in recent if os.path.isfile(p)), None)
        if not path:
            ap.print_usage(sys.stderr)
            return 2
    if not os.path.isfile(path):
        sys.stderr.write('yreader: %s\n' % T('not_found', path))
        return 1
    key = os.path.realpath(path)
    saved = books.get(key)
    if not isinstance(saved, dict):
        saved = {}
    enc = args.encoding or saved.get('enc')
    if enc:
        try:
            FORCE_ENC = codecs.lookup(ALIAS.get(str(enc).lower(), str(enc))).name
        except LookupError:
            if args.encoding:
                sys.stderr.write('yreader: %s\n' % T('bad_enc', enc))
                return 1
    try:
        doc = load(path)
    except Exception as e:
        sys.stderr.write('yreader: %s\n' % T('cant_read', path, e or type(e).__name__))
        return 1

    if args.dump or not sys.stdout.isatty():
        dump(doc)
        return 0

    os.environ.setdefault('ESCDELAY', '25')
    import curses
    try:
        pos = (int(saved.get('para', 0)), int(saved.get('off', 0)))
    except (TypeError, ValueError):
        pos = (0, 0)
    color = args.color or state.get('color') or 'white'

    def bye(*_):
        raise SystemExit(0)

    signal.signal(signal.SIGTERM, bye)
    signal.signal(signal.SIGHUP, bye)

    def run(scr):
        r = Reader(scr, curses, doc, pos, color)
        try:
            r.loop()
        except KeyboardInterrupt:
            pass
        finally:
            pi, off = r.position()
            books[key] = {'para': pi, 'off': off, 'title': doc.title, 'time': int(time.time())}
            if FORCE_ENC:
                books[key]['enc'] = FORCE_ENC
            state['color'] = COLORS[r.ci]
            if CHOSEN:
                state['lang'] = CHOSEN
            save_state(state)

    curses.wrapper(run)
    return 0


if __name__ == '__main__':
    sys.exit(main())

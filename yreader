def dump(doc):
    out = []
    for i, p in enumerate(doc.paras):
        if i and (p.gap or p.newpage or p.style == 'h'):
            out.append('')
        out.append(p.text)
    try:
        sys.stdout.write('\n'.join(out) + '\n')
    except BrokenPipeError:
        pass


def can_show(text):
    try:
        text.encode(sys.stdout.encoding or 'ascii')
        return True
    except (UnicodeError, LookupError):
        return False


def ask_lang(default):
    """第一次執行時詢問介面語言"""
    zh = '繁體中文' if can_show('繁體中文') else 'Chinese'
    sys.stdout.write('Select interface language:\n  1) %s\n  2) English\n[1/2] (default %d): '
                     % (zh, LANGS.index(default) + 1))
    sys.stdout.flush()
    try:
        ans = sys.stdin.readline().strip().lower()
    except (OSError, UnicodeError, KeyboardInterrupt):
        ans = ''
    if ans in ('1', 'zh'):
        return 'zh'
    if ans in ('2', 'en'):
        return 'en'
    return default


def natural_key(name):
    """讓 第2章 排在 第10章 前面"""
    return [int(t) if t.isdigit() else t.lower() for t in re.split(r'(\d+)', name)]


def list_books():
    """列出目前資料夾裡副檔名認得的檔案，一行一個"""
    try:
        names = [n for n in os.listdir('.') if n.lower().endswith(BOOK_EXTS) and os.path.isfile(n)]
    except OSError:
        names = []
    if not names:
        sys.stderr.write('yreader: %s\n' % T('list_none'))
        return 1
    for n in sorted(names, key=natural_key):
        print(n)
    return 0


def main():
    global LANG, FORCE_ENC
    try:
        locale.setlocale(locale.LC_ALL, '')
    except locale.Error:
        pass
    for stream in (sys.stdout, sys.stderr):
        try:
            stream.reconfigure(errors='replace')
        except (AttributeError, ValueError):
            pass
    state = load_state()
    books = state['books']
    saved_lang = state.get('lang') if state.get('lang') in LANGS else None
    zh_ok = can_show(STR['zh']['desc'])      # 終端機無法顯示中文時暫時用英文（不改設定）
    LANG = saved_lang or guess_lang()
    if not zh_ok:
        LANG = 'en'

    ap = argparse.ArgumentParser(prog='yreader', description=T('desc'), epilog=T('epilog'))
    ap.add_argument('file', nargs='?', help=T('arg_file'))
    ap.add_argument('-c', '--color', choices=COLORS, help=T('arg_color'))
    ap.add_argument('-w', '--width', type=int, metavar='N', help=T('arg_width'))
    ap.add_argument('-l', '--lang', choices=LANGS, help=T('arg_lang'))
    ap.add_argument('-e', '--encoding', metavar='ENC', help=T('arg_enc'))
    ap.add_argument('--list', '-list', action='store_true', help=T('arg_list'))
    ap.add_argument('--dump', action='store_true', help=T('arg_dump'))
    ap.add_argument('-V', '--version', action='version', version='yreader ' + VERSION)
    args = ap.parse_args()

    if args.lang:
        LANG = state['lang'] = args.lang
        save_state(state)
        if not zh_ok:
            LANG = 'en'
        if not args.file:
            print(STR[args.lang]['lang_set'] if zh_ok else 'Interface language saved: ' + args.lang)
            return 0
    elif not saved_lang and not args.dump and sys.stdin.isatty() and sys.stdout.isatty():
        LANG = state['lang'] = ask_lang(LANG)
        save_state(state)
        if not zh_ok:
            LANG = 'en'

    path = args.file
    if args.list:
        return list_books()
    if not path:
        recent = sorted(books, key=lambda k: books[k].get('time', 0), reverse=True)
        path = next((p for p in recent if os.path.isfile(p)), None)
        if not path:
            ap.print_usage(sys.stderr)
            return 2
    if not os.path.isfile(path):
        sys.stderr.write('yreader: %s\n' % T('not_found', path))
        return 1
    key = os.path.realpath(path)
    saved = books.get(key)
    if not isinstance(saved, dict):
        saved = {}
    enc = args.encoding or saved.get('enc')
    if enc:
        try:
            FORCE_ENC = codecs.lookup(ALIAS.get(str(enc).lower(), str(enc))).name
        except LookupError:
            if args.encoding:
                sys.stderr.write('yreader: %s\n' % T('bad_enc', enc))
                return 1
    try:
        doc = load(path)
    except Exception as e:
        sys.stderr.write('yreader: %s\n' % T('cant_read', path, e or type(e).__name__))
        return 1

    if args.dump or not sys.stdout.isatty():
        dump(doc)
        return 0

    os.environ.setdefault('ESCDELAY', '25')
    try:
        if os.name == 'nt' or os.environ.get('YREADER_VT'):
            raise ImportError
        import curses
    except ImportError:               # Windows，或 Python 沒有 curses
        curses = VT
    try:
        pos = (int(saved.get('para', 0)), int(saved.get('off', 0)))
    except (TypeError, ValueError):
        pos = (0, 0)
    color = args.color or state.get('color') or 'white'
    try:
        maxw = min(max(int(args.width or state.get('width') or MAX_WIDTH), 20), 400)
    except (TypeError, ValueError):
        maxw = MAX_WIDTH
    pgap = state.get('pgap', True) is not False
    lsp = 2 if state.get('lsp') == 2 else 1
    marks = []
    for m in saved.get('marks') or []:
        try:
            marks.append((int(m[0]), int(m[1])))
        except (TypeError, ValueError, IndexError, KeyError):
            pass

    def bye(*_):
        raise SystemExit(0)

    for name in ('SIGTERM', 'SIGHUP', 'SIGBREAK'):
        if hasattr(signal, name):
            signal.signal(getattr(signal, name), bye)

    saver = []

    def run(scr):
        r = Reader(scr, curses, doc, pos, color, maxw, pgap, lsp, marks)

        def save():
            pi, off = r.position()
            books[key] = {'para': pi, 'off': off, 'title': doc.title, 'time': int(time.time())}
            if FORCE_ENC:
                books[key]['enc'] = FORCE_ENC
            if r.marks:
                books[key]['marks'] = [list(m) for m in r.marks]
            state['color'] = COLORS[r.ci]
            state['width'], state['pgap'], state['lsp'] = r.maxw, r.pgap, r.lsp
            if CHOSEN:
                state['lang'] = CHOSEN
            save_state(state)

        saver.append(save)
        try:
            r.loop()
        except KeyboardInterrupt:
            pass
        finally:
            save()

    handler = None
    if os.name == 'nt':               # 直接關掉視窗時也要保存閱讀紀錄
        try:
            import ctypes

            def on_ctrl(event):
                if event in (2, 5, 6) and saver:      # 關閉視窗 / 登出 / 關機
                    saver[0]()
                return False

            handler = ctypes.WINFUNCTYPE(ctypes.c_int, ctypes.c_uint)(on_ctrl)
            ctypes.windll.kernel32.SetConsoleCtrlHandler(handler, True)
        except Exception:
            handler = None

    try:
        curses.wrapper(run)
    except VTError as e:
        sys.stderr.write('yreader: %s\n' % e)
        return 1
    return 0


if __name__ == '__main__':
    sys.exit(main())

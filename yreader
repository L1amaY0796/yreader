def state_path():
    base = os.environ.get('XDG_DATA_HOME')
    if not base and os.name == 'nt':
        base = os.environ.get('APPDATA')
    if not base:
        base = os.path.join(os.path.expanduser('~'), '.local', 'share')
    return os.path.join(base, 'yreader', 'history.json')


def load_state():
    try:
        with open(state_path(), encoding='utf-8') as f:
            st = json.load(f)
        if isinstance(st, dict) and isinstance(st.get('books', {}), dict):
            st.setdefault('books', {})
            return st
    except (OSError, ValueError):
        pass
    return {'books': {}}


def save_state(st):
    books = st['books']
    if len(books) > 300:
        keep = sorted(books, key=lambda k: books[k].get('time', 0))[-300:]
        st['books'] = dict((k, books[k]) for k in keep)
    p = state_path()
    try:
        os.makedirs(os.path.dirname(p), exist_ok=True)
        tmp = p + '.tmp'
        with open(tmp, 'w', encoding='utf-8') as f:
            json.dump(st, f, indent=1)
        os.replace(tmp, p)
    except OSError:
        pass


# --------------------------------------------------------------------------
# 排版
# --------------------------------------------------------------------------
BLANK = (-1, 0, 0)


def para_indent(p, pgap):
    """關閉段落間距時，一般段落改用首行縮排來區分"""
    return 2 if (not pgap and p.style == 'p' and p.gap and not p.text[:1].isspace()) else 0


def layout(paras, W, H, pgap=True, lsp=1):
    """回傳 (lines, first)；lines 為 [(段落, 起, 迄)]，first[段落] = 第一行的索引"""
    lines = []
    first = [0] * len(paras)
    prev = None
    for pi, p in enumerate(paras):
        if lines:
            if p.newpage:
                r = len(lines) % H
                if r:
                    lines.extend([BLANK] * (H - r))
            elif ((p.gap and (pgap or p.style != prev.style)) or p.style == 'h' or prev.style == 'h') \
                    and len(lines) % H:
                lines.append(BLANK)
        segs = wrap(p.text, W, para_indent(p, pgap))
        if p.style == 'h':            # 標題不要孤零零留在頁尾
            r = len(lines) % H
            need = len(segs) * lsp + 2
            if r and need <= H and H - r < need:
                lines.extend([BLANK] * (H - r))
        first[pi] = len(lines)
        for s, e in segs:
            lines.append((pi, s, e))
            if lsp > 1 and len(lines) % H:
                lines.append(BLANK)
        prev = p
    return lines, first


# --------------------------------------------------------------------------
# 介面
# --------------------------------------------------------------------------
class Reader(object):
    def __init__(self, scr, curses, doc, pos, color, maxw=MAX_WIDTH, pgap=True, lsp=1, marks=()):
        self.scr = scr
        self.c = curses
        self.doc = doc
        self.ci = COLORS.index(color) if color in COLORS else 0
        self.page = 0
        self.sel = None           # 選取中的連結 (段落, 連結索引)
        self.mark = None          # 連結跳轉後標示的行
        self.hist = []
        self.msg = ''
        self.numbuf = None
        self.lines = []
        self.maxw = maxw          # 版面：最大欄寬 / 段落間距 / 行距
        self.pgap = pgap
        self.lsp = lsp
        self.query = ''           # 搜尋
        self.lastq = ''
        self.matches = []         # [(段落, 起, 迄)]
        self.bypara = {}          # 段落 -> [(起, 迄, 第幾個結果)]
        self.mi = 0
        self.origin = None        # 搜尋前的位置
        self.marks = sorted(set(marks))   # 書籤 [(段落, 位移)]
        self.has_color = False
        try:
            curses.curs_set(0)
        except curses.error:
            pass
        try:
            if curses.has_colors():
                curses.start_color()
                try:
                    curses.use_default_colors()
                    bg = -1
                except curses.error:
                    bg = curses.COLOR_BLACK
                for i, col in enumerate((curses.COLOR_WHITE, curses.COLOR_GREEN, curses.COLOR_BLUE)):
                    curses.init_pair(i + 1, col, bg)
                self.has_color = True
        except curses.error:
            pass
        self.relayout(pos)

    # ---- 位置 ----
    def attr(self):
        return self.c.color_pair(self.ci + 1) if self.has_color else 0

    def relayout(self, pos=None):
        if pos is None:
            pos = self.position()
        rows, cols = self.scr.getmaxyx()
        self.H = max(1, rows - 2)
        self.W = max(8, min(cols - 4, self.maxw))
        self.x0 = max(0, (cols - self.W) // 2)
        self.lines, self.first = layout(self.doc.paras, self.W, self.H, self.pgap, self.lsp)
        self.npages = max(1, (len(self.lines) + self.H - 1) // self.H)
        self.toc_lines = [self.line_of(t) for _, _, t in self.doc.toc]
        self.page = min(self.line_of(pos) // self.H, self.npages - 1)
        self.mark = None

    def line_of(self, pos):
        pi, off = pos
        if not self.lines:
            return 0
        pi = min(max(pi, 0), len(self.first) - 1)
        i = self.first[pi]
        n = len(self.lines)
        while i + 1 < n and self.lines[i + 1][0] == pi and self.lines[i + 1][1] <= off:
            i += 1
        return i

    def position(self):
        base = self.page * self.H
        for i in range(base, min(base + self.H, len(self.lines))):
            pi, s, _ = self.lines[i]
            if pi >= 0:
                return (pi, s)
        return (0, 0)

    def set_page(self, n, remember=False):
        n = min(max(n, 0), self.npages - 1)
        if n != self.page:
            if remember:
                self.hist.append(self.position())
            self.page = n
        self.sel = None
        self.mark = None

    def jump(self, pos, mark=False):
        self.hist.append(self.position())
        ln = self.line_of(pos)
        self.page = min(ln // self.H, self.npages - 1)
        self.sel = None
        self.mark = ln if mark else None

    def cur_toc(self):
        end = (self.page + 1) * self.H
        cur = -1
        for i, ln in enumerate(self.toc_lines):
            if ln < end:
                cur = i
        return cur

    # ---- 繪製 ----
    def put(self, y, x, s, attr=0):
        rows, cols = self.scr.getmaxyx()
        if y < 0 or y >= rows or x < 0 or x >= cols:
            return x
        s = clip(s, cols - x)
        try:
            self.scr.addstr(y, x, s, attr)
        except self.c.error:
            pass
        except UnicodeError:      # 終端機編碼無法表示的字元
            enc = getattr(self.scr, 'encoding', None) or 'ascii'
            try:
                self.scr.addstr(y, x, s.encode(enc, 'replace').decode(enc, 'replace'), attr)
            except (self.c.error, UnicodeError, LookupError):
                pass
        return x + swidth(s)

    def status(self, left, right=''):
        rows, cols = self.scr.getmaxyx()
        a = self.attr() | self.c.A_REVERSE
        y = rows - 1
        self.put(y, 0, ' ' * (cols - 1), a)
        right = clip(right, cols - 2)
        room = cols - 3 - swidth(right)
        self.put(y, 1, clip(left, room), a)
        self.put(y, cols - 1 - swidth(right), right, a)

    def draw(self):
        c = self.c
        self.scr.erase()
        attr = self.attr()
        paras = self.doc.paras
        base = self.page * self.H
        mark = self.mark
        if self.matches:
            m = self.matches[self.mi]
            mark = self.line_of((m[0], m[1]))
        for y in range(self.H):
            i = base + y
            if i >= len(self.lines):
                break
            pi, s, e = self.lines[i]
            if pi < 0:
                continue
            p = paras[pi]
            a = attr | (c.A_BOLD if p.style == 'h' else 0)
            x = self.x0
            if p.style in ('h', 'hr'):
                x += max(0, (self.W - swidth(p.text[s:e].rstrip())) // 2)
            elif s == 0:
                x += para_indent(p, self.pgap)
            if i == mark and self.x0 >= 2:
                self.put(y, self.x0 - 2, '>', attr | c.A_BOLD)
            spans = []                # (起, 迄, 額外屬性)：連結加底線，搜尋結果反白
            for k, (ls, le, _) in enumerate(p.links):
                if ls < e and le > s:
                    spans.append((ls, le, c.A_REVERSE if self.sel == (pi, k) else c.A_UNDERLINE))
            for ms, me, idx in self.bypara.get(pi, ()):
                if ms < e and me > s:
                    spans.append((ms, me, c.A_REVERSE | (c.A_BOLD if idx == self.mi else 0)))
            if not spans:
                self.put(y, x, p.text[s:e], a)
                continue
            cuts = sorted(set([s, e] + [min(max(v, s), e) for sp in spans for v in sp[:2]]))
            for st, en in zip(cuts, cuts[1:]):
                sa = a
                for ss, se, extra in spans:
                    if ss <= st and en <= se:
                        sa |= extra
                x = self.put(y, x, p.text[st:en], sa)

        if self.numbuf is not None:
            self.status(T('goto', self.numbuf), T('total', self.npages))
        else:
            left = self.msg
            if not left and self.matches:
                left = T('search_status', self.query, self.mi + 1, len(self.matches))
            elif not left:
                left = self.doc.title
                ti = self.cur_toc()
                if ti >= 0 and self.doc.toc[ti][1] != self.doc.title:
                    left += ' ─ ' + self.doc.toc[ti][1]
            if self.matches:          # 搜尋中：右側只留頁碼，把空間讓給提示
                right = '%d/%d' % (self.page + 1, self.npages)
            else:
                right = T('status', self.page + 1, self.npages, 100 * (self.page + 1) // self.npages)
            if self.marks_here():
                right = T('bm_flag') + ' ' + right
            cols = self.scr.getmaxyx()[1]
            if self.msg and swidth(left) > cols - 3 - swidth(right):
                right = ''                # 訊息太長時（例如檔案路徑）讓出整列
            self.status(left, right)
        self.msg = ''
        self.scr.refresh()

    # ---- 輸入 ----
    def getkey(self):
        try:
            return self.scr.get_wch()
        except AttributeError:
            k = self.scr.getch()
            return chr(k) if 0 <= k < 256 else k
        except self.c.error:
            return None

    def is_enter(self, k):
        return k in ('\n', '\r', self.c.KEY_ENTER)

    def is_back(self, k):
        return k in (self.c.KEY_BACKSPACE, '\x7f', '\x08')

    # ---- 連結 ----
    def page_links(self):
        out = []
        base = self.page * self.H
        for i in range(base, min(base + self.H, len(self.lines))):
            pi, s, e = self.lines[i]
            if pi < 0:
                continue
            for k, (ls, le, _) in enumerate(self.doc.paras[pi].links):
                if ls < e and le > s and (pi, k) not in out:
                    out.append((pi, k))
        return out

    def cycle_link(self, step):
        links = self.page_links()
        if not links:
            self.msg = T('no_links')
            return
        if self.sel in links:
            self.sel = links[(links.index(self.sel) + step) % len(links)]
        else:
            self.sel = links[0 if step > 0 else -1]
        if self.doc.paras[self.sel[0]].links[self.sel[1]][2].startswith(IMG):
            self.msg = T('img_hint')

    def follow(self):
        if self.sel is None:
            self.cycle_link(1)
            return
        pi, k = self.sel
        href = self.doc.paras[pi].links[k][2]
        if href.startswith(IMG):
            self.open_image(href[len(IMG):])
            return
        if SCHEME.match(href):
            self.msg = T('ext_link', href)
            return
        t = self.doc.lookup(href)
        if t is None:
            self.msg = T('no_target', href)
            return
        self.jump(t, mark=True)

    def open_image(self, key):
        try:
            data = self.doc.get_image(key)
        except Exception:
            data = None
        if not data:
            self.msg = T('img_missing')
            return
        try:
            path = save_image(key, data)
        except OSError as e:
            self.msg = str(e)
            return
        self.msg = T('img_opened') if open_external(path) else T('img_saved', path)

    def back(self):
        if not self.hist:
            self.msg = T('no_back')
            return
        pos = self.hist.pop()
        self.page = min(self.line_of(pos) // self.H, self.npages - 1)
        self.sel = None
        self.mark = None

    def chapter(self, step):
        pages = sorted(set(ln // self.H for ln in self.toc_lines))
        if step > 0:
            nxt = [p for p in pages if p > self.page]
        else:
            nxt = [p for p in reversed(pages) if p < self.page]
        if nxt:
            self.set_page(nxt[0], remember=True)
        else:
            self.msg = T('no_next' if step > 0 else 'no_prev')

    # ---- 搜尋 ----
    def prompt(self, label):
        """在狀態列輸入一行文字；Esc 取消時回傳 None"""
        c = self.c
        buf = ''
        hint = T('prompt_hint')
        while True:
            self.draw()
            cols = self.scr.getmaxyx()[1]
            text = label + buf + '_'
            room = cols - 4 - swidth(hint)
            while len(text) > 1 and swidth(text) > room:
                text = text[1:]
            self.status(text, hint)
            self.scr.refresh()
            k = self.getkey()
            if k == c.KEY_RESIZE:
                self.relayout()
            elif self.is_enter(k):
                return buf
            elif k == '\x1b':
                return None
            elif self.is_back(k):
                if not buf:
                    return None
                buf = buf[:-1]
            elif k == '\x15':             # Ctrl-U 清空
                buf = ''
            elif isinstance(k, str) and k >= ' ':
                buf += k

    def search(self):
        q = self.prompt(T('search_prompt'))
        if q is None:
            return
        q = norm(q) or self.lastq         # 直接按 Enter：重複上次的搜尋
        if not q:
            return
        self.lastq = q
        rx = re.compile(re.escape(q), re.IGNORECASE)
        matches, bypara = [], {}
        for pi, p in enumerate(self.doc.paras):
            for m in rx.finditer(p.text):
                bypara.setdefault(pi, []).append((m.start(), m.end(), len(matches)))
                matches.append((pi, m.start(), m.end()))
        if not matches:
            self.msg = T('no_match', q)
            return
        if not self.matches:              # 連續搜尋時保留最初的位置
            self.origin = self.position()
        self.query, self.matches, self.bypara = q, matches, bypara
        start = self.page * self.H
        self.mi = 0
        for i, m in enumerate(matches):   # 從目前這一頁開始往後找
            if self.line_of((m[0], m[1])) >= start:
                self.mi = i
                break
        else:
            self.msg = T('wrap_start')
        self.show_match()

    def show_match(self):
        m = self.matches[self.mi]
        self.page = min(self.line_of((m[0], m[1])) // self.H, self.npages - 1)
        self.sel = None
        self.mark = None

    def next_match(self, step):
        if not self.matches:
            self.msg = T('no_search')
            return
        i = self.mi + step
        if i >= len(self.matches):
            self.msg = T('wrap_start')
        elif i < 0:
            self.msg = T('wrap_end')
        self.mi = i % len(self.matches)
        self.show_match()

    def end_search(self, back):
        """結束搜尋；back=True 時回到搜尋前的頁面"""
        if not self.matches:
            return False
        origin = self.origin
        self.query, self.matches, self.bypara, self.origin = '', [], {}, None
        if origin is not None:
            if back:
                self.page = min(self.line_of(origin) // self.H, self.npages - 1)
            elif self.line_of(origin) // self.H != self.page:
                self.hist.append(origin)      # 留在此頁時，Backspace 仍可回去
        self.sel = None
        self.mark = None
        return True

    # ---- 書籤 ----
    def marks_here(self):
        return [m for m in self.marks if self.line_of(m) // self.H == self.page]

    def toggle_mark(self):
        here = self.marks_here()
        if here:
            self.marks = [m for m in self.marks if m not in here]
            self.msg = T('bm_del')
        else:
            self.marks = sorted(set(self.marks + [self.position()]))
            self.msg = T('bm_add', len(self.marks))

    def marks_view(self):
        c = self.c
        paras = self.doc.paras
        start = self.page * self.H
        cur = 0
        for i, m in enumerate(self.marks):        # 預設選在目前位置之後的第一個
            if self.line_of(m) >= start:
                cur = i
                break
        while True:
            if not self.marks:
                self.msg = T('bm_none')
                return
            cur = min(max(cur, 0), len(self.marks) - 1)
            rows, cols = self.scr.getmaxyx()
            h = max(1, rows - 2)
            w = max(8, min(cols - 4, MAX_WIDTH))
            x0 = max(0, (cols - w) // 2)
            top = min(max(0, cur - h // 2), max(0, len(self.marks) - h))
            attr = self.attr()
            self.scr.erase()
            self.put(0, x0, T('bm_title'), attr | c.A_BOLD)
            for y in range(h):
                i = top + y
                if i >= len(self.marks):
                    break
                pi, off = self.marks[i]
                ln = self.line_of((pi, off))
                pg = str(ln // self.H + 1)
                chap = ''
                for j, tl in enumerate(self.toc_lines):
                    if tl <= ln:
                        chap = self.doc.toc[j][1]
                text = ' '.join(paras[min(max(pi, 0), len(paras) - 1)].text[off:off + 120].split())
                row = clip((chap + ' ─ ' if chap and chap != text else '') + text, w - len(pg) - 2)
                row += ' ' * (w - len(pg) - swidth(row)) + pg
                self.put(1 + y, x0, row, attr | (c.A_REVERSE if i == cur else 0))
            self.status(T('bm_hint'), '%d/%d' % (cur + 1, len(self.marks)))
            self.scr.refresh()
            k = self.getkey()
            if k == c.KEY_RESIZE:
                self.relayout()
            elif k in (c.KEY_DOWN, 'j'):
                cur += 1
            elif k in (c.KEY_UP, 'k'):
                cur -= 1
            elif k in (c.KEY_NPAGE, ' '):
                cur += h
            elif k == c.KEY_PPAGE:
                cur -= h
            elif k in (c.KEY_HOME, 'g'):
                cur = 0
            elif k in (c.KEY_END, 'G'):
                cur = len(self.marks) - 1
            elif k in ('d', 'x', c.KEY_DC):
                del self.marks[cur]
            elif self.is_enter(k) or k in (c.KEY_RIGHT, 'l'):
                self.jump(self.marks[cur], mark=True)
                return
            elif k in ('M', 'm', 'q', '\x1b', c.KEY_LEFT, 'h'):
                return

    # ---- 版面 ----
    def set_width(self, step):
        cols = self.scr.getmaxyx()[1]
        room = max(20, cols - 4)
        self.maxw = min(max(min(self.maxw, room) + step, 20), room)
        self.relayout()
        self.msg = T('width', self.W)

    # ---- 目錄 / 說明 ----
    def toc_view(self):
        c = self.c
        toc = self.doc.toc
        if not toc:
            self.msg = T('no_toc')
            return
        cur = max(self.cur_toc(), 0)
        while True:
            rows, cols = self.scr.getmaxyx()
            h = max(1, rows - 2)
            w = max(8, min(cols - 4, MAX_WIDTH))
            x0 = max(0, (cols - w) // 2)
            top = min(max(0, cur - h // 2), max(0, len(toc) - h))
            attr = self.attr()
            self.scr.erase()
            self.put(0, x0, T('toc'), attr | c.A_BOLD)
            for y in range(h):
                i = top + y
                if i >= len(toc):
                    break
                lvl, title, _ = toc[i]
                pg = str(self.toc_lines[i] // self.H + 1)
                row = clip('  ' * min(lvl, 8) + title, w - len(pg) - 2)
                row += ' ' * (w - len(pg) - swidth(row)) + pg
                self.put(1 + y, x0, row, attr | (c.A_REVERSE if i == cur else 0))
            self.status(T('toc_hint'), '%d/%d' % (cur + 1, len(toc)))
            self.scr.refresh()
            k = self.getkey()
            if k == c.KEY_RESIZE:
                self.relayout()
            elif k in (c.KEY_DOWN, 'j'):
                cur = min(cur + 1, len(toc) - 1)
            elif k in (c.KEY_UP, 'k'):
                cur = max(cur - 1, 0)
            elif k in (c.KEY_NPAGE, ' '):
                cur = min(cur + h, len(toc) - 1)
            elif k == c.KEY_PPAGE:
                cur = max(cur - h, 0)
            elif k in (c.KEY_HOME, 'g'):
                cur = 0
            elif k in (c.KEY_END, 'G'):
                cur = len(toc) - 1
            elif self.is_enter(k) or k in (c.KEY_RIGHT, 'l'):
                self.jump(toc[cur][2])
                return
            elif k in ('t', 'q', '\x1b', c.KEY_LEFT, 'h'):
                return

    def help_view(self):
        c = self.c
        top = 0
        while True:
            rows, cols = self.scr.getmaxyx()
            attr = self.attr()
            table = HELP[LANG]
            h = max(1, rows - 3)
            top = min(top, max(0, len(table) - 1))
            self.scr.erase()
            self.put(0, 2, T('help_title', VERSION), attr | c.A_BOLD)
            col = 4 + max(swidth(keys) for keys, _ in table)
            for i, (keys, desc) in enumerate(table[top:top + h]):
                self.put(2 + i, 2, keys, attr | c.A_BOLD)
                self.put(2 + i, col, desc, attr)
            more = top + h < len(table)       # 視窗太矮時分頁顯示
            self.status(T('help_more' if more else 'anykey'))
            self.scr.refresh()
            k = self.getkey()
            if k == c.KEY_RESIZE:
                self.relayout()
            elif k is not None:
                if not more or k in ('q', '\x1b'):
                    return
                top += h

    # ---- 主迴圈 ----
    def loop(self):
        global LANG, CHOSEN
        c = self.c
        nxt = {' ', 'j', 'l', c.KEY_DOWN, c.KEY_RIGHT, c.KEY_NPAGE}
        prv = {'k', 'h', c.KEY_UP, c.KEY_LEFT, c.KEY_PPAGE}
        while True:
            self.draw()
            k = self.getkey()
            if k is None:
                continue
            if k == c.KEY_RESIZE:
                self.relayout()
                continue
            if self.numbuf is not None:
                if isinstance(k, str) and k.isascii() and k.isdigit():
                    if len(self.numbuf) < 9:
                        self.numbuf += k
                elif self.is_back(k):
                    self.numbuf = self.numbuf[:-1] or None
                else:
                    if self.is_enter(k):
                        n = int(self.numbuf)
                        if 1 <= n <= self.npages:
                            self.set_page(n - 1, remember=True)
                        else:
                            self.msg = T('range', self.npages)
                    self.numbuf = None
                continue
            if isinstance(k, str) and k.isascii() and k.isdigit():
                self.numbuf = k
            elif k in nxt:
                if self.page >= self.npages - 1:
                    self.msg = T('last')
                self.set_page(self.page + 1)
            elif k in prv:
                if self.page == 0:
                    self.msg = T('first')
                self.set_page(self.page - 1)
            elif k in ('g', c.KEY_HOME):
                self.set_page(0, remember=True)
            elif k in ('G', c.KEY_END):
                self.set_page(self.npages - 1, remember=True)
            elif k == ']':
                self.chapter(1)
            elif k == '[':
                self.chapter(-1)
            elif k == '\t':
                self.cycle_link(1)
            elif k == c.KEY_BTAB:
                self.cycle_link(-1)
            elif self.is_enter(k):
                if self.sel is None and self.matches:
                    self.end_search(False)
                else:
                    self.follow()
            elif k == 'm':
                self.toggle_mark()
            elif k == 'M':
                self.marks_view()
            elif k == '/':
                self.search()
            elif k == 'n':
                self.next_match(1)
            elif k == 'N':
                self.next_match(-1)
            elif k in ('-', '_'):
                self.set_width(-4)
            elif k in ('+', '='):
                self.set_width(4)
            elif k == 's':
                self.pgap = not self.pgap
                self.relayout()
                self.msg = T('pgap_on' if self.pgap else 'pgap_off')
            elif k == 'd':
                self.lsp = 2 if self.lsp == 1 else 1
                self.relayout()
                self.msg = T('lsp%d' % self.lsp)
            elif self.is_back(k) or k == 'b':
                self.back()
            elif k == 't':
                self.toc_view()
            elif k == 'c':
                self.ci = (self.ci + 1) % len(COLORS)
                self.msg = T('color', T(COLORS[self.ci]))
            elif k == 'L':
                LANG = CHOSEN = LANGS[(LANGS.index(LANG) + 1) % len(LANGS)]
                self.msg = T('lang_now')
            elif k == '?':
                self.help_view()
            elif k == '\x1b':
                if not self.end_search(True):
                    self.sel = None
            elif k in ('q', 'Q'):
                return


# --------------------------------------------------------------------------
# 不依賴 curses 的終端機後端（ANSI / VT 控制碼）
# Windows 沒有 curses，所以在 PowerShell / cmd 裡用這個；Python 沒編 curses 的 Linux 也會用到
# --------------------------------------------------------------------------
class VTError(Exception):
    pass


class VT(object):
    """提供 Reader 用到的那一小部分 curses 介面"""
    error = VTError
    A_BOLD, A_REVERSE, A_UNDERLINE = 1, 2, 4
    COLOR_BLACK, COLOR_GREEN, COLOR_BLUE, COLOR_WHITE = 0, 2, 4, 7
    (KEY_DOWN, KEY_UP, KEY_LEFT, KEY_RIGHT, KEY_HOME, KEY_END, KEY_NPAGE, KEY_PPAGE,
     KEY_BTAB, KEY_DC, KEY_ENTER, KEY_BACKSPACE, KEY_RESIZE) = range(1000, 1013)
    pairs = {}

    @staticmethod
    def curs_set(n):
        pass

    @staticmethod
    def has_colors():
        return True

    @staticmethod
    def start_color():
        pass

    @staticmethod
    def use_default_colors():
        pass

    @staticmethod
    def init_pair(n, fg, bg):
        VT.pairs[n] = fg

    @staticmethod
    def color_pair(n):
        return n << 8

    @staticmethod
    def wrapper(func):
        restore = VT.setup()
        out = sys.stdout
        try:
            out.write('\x1b[?1049h\x1b[?25l\x1b[?7l')     # 替代畫面、隱藏游標、關閉自動換行
            out.flush()
            return func(VTScreen())
        finally:
            try:
                out.write('\x1b[0m\x1b[?7h\x1b[?25h\x1b[?1049l')
                out.flush()
            except (OSError, ValueError):
                pass
            restore()

    @staticmethod
    def setup():
        """把終端機切到可用的模式，回傳還原用的函式"""
        if os.name == 'nt':
            import ctypes
            k32 = ctypes.windll.kernel32
            k32.GetStdHandle.restype = ctypes.c_void_p
            handle = ctypes.c_void_p(k32.GetStdHandle(-11))
            mode = ctypes.c_uint32()
            if not k32.GetConsoleMode(handle, ctypes.byref(mode)):
                raise VTError(T('no_vt'))
            # ENABLE_PROCESSED_OUTPUT | ENABLE_VIRTUAL_TERMINAL_PROCESSING
            if not k32.SetConsoleMode(handle, ctypes.c_uint32(mode.value | 0x0001 | 0x0004)):
                raise VTError(T('no_vt'))
            return lambda: k32.SetConsoleMode(handle, mode)
        import termios
        import tty
        fd = sys.stdin.fileno()
        old = termios.tcgetattr(fd)
        tty.setcbreak(fd)
        return lambda: termios.tcsetattr(fd, termios.TCSADRAIN, old)


class VTScreen(object):
    encoding = 'utf-8'
    FG = {VT.COLOR_WHITE: '37', VT.COLOR_GREEN: '32',
          VT.COLOR_BLUE: '94' if os.name == 'nt' else '34'}   # Windows 主控台的深藍太暗，用亮藍
    WINKEYS = {'H': VT.KEY_UP, 'P': VT.KEY_DOWN, 'K': VT.KEY_LEFT, 'M': VT.KEY_RIGHT,
               'G': VT.KEY_HOME, 'O': VT.KEY_END, 'I': VT.KEY_PPAGE, 'Q': VT.KEY_NPAGE,
               'S': VT.KEY_DC, '\x0f': VT.KEY_BTAB}
    SEQS = {b'[A': VT.KEY_UP, b'[B': VT.KEY_DOWN, b'[C': VT.KEY_RIGHT, b'[D': VT.KEY_LEFT,
            b'OA': VT.KEY_UP, b'OB': VT.KEY_DOWN, b'OC': VT.KEY_RIGHT, b'OD': VT.KEY_LEFT,
            b'[H': VT.KEY_HOME, b'[F': VT.KEY_END, b'OH': VT.KEY_HOME, b'OF': VT.KEY_END,
            b'[1~': VT.KEY_HOME, b'[4~': VT.KEY_END, b'[7~': VT.KEY_HOME, b'[8~': VT.KEY_END,
            b'[5~': VT.KEY_PPAGE, b'[6~': VT.KEY_NPAGE, b'[3~': VT.KEY_DC, b'[Z': VT.KEY_BTAB}

    def __init__(self):
        self.rows = {}
        self.size = self.getmaxyx()
        self.buf = b''

    def getmaxyx(self):
        sz = shutil.get_terminal_size((80, 24))
        return (max(1, sz.lines), max(1, sz.columns))

    def erase(self):
        self.rows = {}

    def addstr(self, y, x, s, attr=0):
        self.rows.setdefault(y, []).append((x, s, attr))

    def refresh(self):
        out = []
        for y in range(self.getmaxyx()[0]):
            out.append('\x1b[%d;1H\x1b[0m\x1b[2K' % (y + 1))
            for x, s, attr in self.rows.get(y, ()):
                sgr = ['0']
                if attr & VT.A_BOLD:
                    sgr.append('1')
                if attr & VT.A_UNDERLINE:
                    sgr.append('4')
                if attr & VT.A_REVERSE:
                    sgr.append('7')
                fg = self.FG.get(VT.pairs.get(attr >> 8))
                if fg:
                    sgr.append(fg)
                out.append('\x1b[%d;%dH\x1b[%sm%s' % (y + 1, x + 1, ';'.join(sgr), s))
        out.append('\x1b[0m')
        sys.stdout.write(''.join(out))
        sys.stdout.flush()

    def resized(self):
        size = self.getmaxyx()
        if size != self.size:
            self.size = size
            return True
        return False

    def get_wch(self):
        return self.key_nt() if os.name == 'nt' else self.key_posix()

    def key_nt(self):
        import msvcrt
        while not msvcrt.kbhit():           # 順便偵測視窗大小改變
            if self.resized():
                return VT.KEY_RESIZE
            time.sleep(0.03)
        ch = msvcrt.getwch()
        if ch in ('\x00', '\xe0'):          # 方向鍵等功能鍵：兩段式
            return self.WINKEYS.get(msvcrt.getwch())
        if ch == '\x03':
            raise KeyboardInterrupt
        if '\ud800' <= ch <= '\udbff':      # BMP 以外的字元會分成兩半送來
            ch = (ch + msvcrt.getwch()).encode('utf-16', 'surrogatepass').decode('utf-16', 'replace')
        return ch

    def more(self, timeout):
        import select
        fd = sys.stdin.fileno()
        if select.select([fd], [], [], timeout)[0]:
            data = os.read(fd, 64)
            if not data:
                raise SystemExit(0)         # 終端機已關閉
            self.buf += data
            return True
        return False

    def key_posix(self):
        while not self.buf:
            if not self.more(0.2) and self.resized():
                return VT.KEY_RESIZE
        b = self.buf
        if b[:1] == b'\x1b':
            if len(b) == 1 and not self.more(0.05):
                self.buf = b''
                return '\x1b'               # 單獨的 Esc
            b = self.buf
            for n in (3, 2):
                key = self.SEQS.get(b[1:1 + n])
                if key:
                    self.buf = b[1 + n:]
                    return key
            if b[1:2] == b'[':              # 不認得的控制序列：整段丟掉
                i = 2
                while i < len(b) and not 0x40 <= b[i] <= 0x7e:
                    i += 1
                self.buf = b[i + 1:]
                return None
            self.buf = b[1:]
            return '\x1b'
        lead = b[0]
        n = 1 if lead < 0xc0 else 2 if lead < 0xe0 else 3 if lead < 0xf0 else 4
        while len(self.buf) < n and self.more(0.05):
            pass
        ch, self.buf = self.buf[:n], self.buf[n:]
        return ch.decode('utf-8', 'replace')[:1] or None



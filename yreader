def local(tag):
    return tag.rsplit('}', 1)[-1] if isinstance(tag, str) else ''


class NavParser(HTMLParser):
    """EPUB3 nav 文件 -> 目錄"""

    def __init__(self, base):
        HTMLParser.__init__(self, convert_charrefs=True)
        self.base = base
        self.out = []
        self.on = 0
        self.lvl = 0
        self.href = None
        self.text = []

    def handle_starttag(self, tag, attrs):
        a = dict(attrs)
        if tag == 'nav':
            if self.on:
                self.on += 1
            elif 'toc' in (a.get('epub:type') or 'toc'):
                self.on = 1
                self.lvl = 0
        elif not self.on:
            return
        elif tag == 'ol':
            self.lvl += 1
        elif tag == 'a' and a.get('href'):
            self.href = a['href']
            self.text = []

    def handle_endtag(self, tag):
        if not self.on:
            return
        if tag == 'nav':
            self.on -= 1
        elif tag == 'ol':
            self.lvl -= 1
        elif tag == 'a' and self.href:
            title = ' '.join(''.join(self.text).split())
            self.out.append((max(0, self.lvl - 1), title, resolve(self.base, self.href)))
            self.href = None

    def handle_data(self, data):
        if self.href:
            self.text.append(data)


def ncx_toc(xml, base):
    out = []

    def walk(e, lvl):
        for c in e:
            t = local(c.tag)
            if t == 'navPoint':
                label, src = '', None
                for g in c:
                    gt = local(g.tag)
                    if gt == 'navLabel':
                        label = ' '.join(''.join(g.itertext()).split())
                    elif gt == 'content':
                        src = g.get('src')
                if src:
                    out.append((lvl, label, resolve(base, src)))
                walk(c, lvl + 1)
            elif t == 'navMap':
                walk(c, lvl)

    walk(ET.fromstring(xml), 0)
    return out


def load_epub(path, doc):
    z = zipfile.ZipFile(path)
    names = set(z.namelist())
    loose = {}

    def nk(n):
        return unicodedata.normalize('NFC', n).lower()

    for n in names:
        loose.setdefault(nk(n), n)
        try:      # 檔名其實是 UTF-8 卻沒有標示的 zip
            loose.setdefault(nk(n.encode('cp437').decode('utf-8')), n)
        except UnicodeError:
            pass

    def read(name):
        if name not in names:
            name = loose[nk(name)]
        return z.read(name)

    opf = None
    for e in ET.fromstring(read('META-INF/container.xml')).iter():
        if local(e.tag) == 'rootfile':
            opf = unquote(e.get('full-path') or '')
            break
    if not opf:
        raise ValueError(T('bad_file', 'OPF'))
    opfdir = posixpath.dirname(opf)
    manifest, spine, tocid = {}, [], None
    for e in ET.fromstring(read(opf)).iter():
        t = local(e.tag)
        if t == 'item':
            href = posixpath.normpath(posixpath.join(opfdir, unquote(e.get('href') or '')))
            manifest[e.get('id')] = (href, e.get('media-type') or '', e.get('properties') or '')
        elif t == 'itemref':
            spine.append(e.get('idref'))
        elif t == 'spine':
            tocid = e.get('toc')
        elif t == 'title' and not doc.title:
            doc.title = ' '.join((e.text or '').split())

    doc.image_loader = read
    for idref in spine:
        if idref not in manifest:
            continue
        href, mt, _ = manifest[idref]
        try:
            raw = read(href)
        except KeyError:
            continue
        doc.start_file(href)
        if mt.startswith('image/'):
            doc.add_image(href)
            continue
        ContentParser(doc, href).run(decode(raw))

    # 目錄：先找 NCX，再找 EPUB3 nav
    cands = [manifest[tocid]] if tocid in manifest else []
    cands += [v for v in manifest.values() if v[1] == 'application/x-dtbncx+xml']
    for href, _, _ in cands:
        try:
            doc.rawtoc = ncx_toc(read(href), href)
        except Exception:
            continue
        if doc.rawtoc:
            return
    for href, _, props in manifest.values():
        if 'nav' in props.split():
            try:
                p = NavParser(href)
                p.feed(decode(read(href)))
                doc.rawtoc = p.out
            except Exception:
                pass
            return


